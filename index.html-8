<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="-oGEEEyoPbsyOVH7EOF3pAKPJ49IxacUo1LY5g5sgoA" />
  <meta name="google-site-verification" content="pm96BuydbJw4945mbLTlRTScgiGLVAlV4mWQkt5Y25Y" />
  <meta name="description" content="Cotygodniowy ranking najbardziej wpływowych chadów w polskiej społeczności. Głosuj na faworytów!">
  <meta property="og:title" content="Polish Chad Rankings">
  <meta property="og:description" content="Głosuj na najbardziej wpływowych chadów w polskiej społeczności!">
  <meta property="og:image" content="https://polish-chad-rankings.netlify.app/MORPH.jpg">
  <title>Polish Chad Rankings & Community</title>

  <!-- Biblioteki Firebase SDK (Compat) -->
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>


  <style>
    :root {
      --bg: radial-gradient(circle at top, #1e0c38 0%, #08070c 100%);
      --card-bg: #12111a;
      --purple-main: #a855f7;
      --purple-light: #c084fc;
      --purple-gradient: linear-gradient(135deg, #a855f7 0%, #6b21a8 100%);
      --gold-accent: #facc15;
      --text: #ffffff;
      --subtext: #8e8d9f;
      --accent-red: #ff2a4b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      background: #08070c;
      background-image: var(--bg);
      background-attachment: fixed;
      color: var(--text);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      padding-bottom: 32px;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(12, 10, 20, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(168, 85, 247, 0.15);
      padding: 10px 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .header-logo {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(168, 85, 247, 0.15);
      border: 1px solid rgba(168, 85, 247, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .header-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    h1 {
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: var(--text);
      text-transform: uppercase;
      text-align: center;
    }

    .lang-switch {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .flag-btn {
      font-size: 1.3rem;
      cursor: pointer;
      opacity: 0.4;
      transition: all 0.2s ease;
      filter: grayscale(40%);
    }

    .flag-btn.active {
      opacity: 1;
      transform: scale(1.15);
      filter: grayscale(0%);
    }

    .tabs {
      display: flex;
      justify-content: center;
      gap: 12px;
      width: 100%;
    }

    .tab {
      color: var(--subtext);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 6px 12px;
      border-bottom: 2px solid transparent;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .tab.active {
      color: var(--text);
      border-bottom-color: var(--purple-main);
    }

    .content {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .tab-view {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .tab-view.hidden {
      display: none !important;
    }

    .hero-section {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
    }

    .badge-updated {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(168, 85, 247, 0.15);
      border: 1px solid rgba(168, 85, 247, 0.35);
      color: var(--purple-light);
      font-size: 0.8rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 20px;
    }

    .hero-description {
      font-size: 0.85rem;
      color: var(--subtext);
      line-height: 1.4;
      max-width: 320px;
    }

    .badge-verified {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(168, 85, 247, 0.2);
      color: #d1d5db;
      font-size: 0.75rem;
      padding: 6px 12px;
      border-radius: 20px;
    }

    /* Ankieta */
    .poll-card {
      background: #100d1a;
      border: 1px solid rgba(168, 85, 247, 0.35);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 15px rgba(168, 85, 247, 0.15);
    }

    .poll-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--purple-light);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }

    .poll-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.3;
    }

    .poll-subtitle {
      font-size: 0.78rem;
      color: var(--subtext);
      line-height: 1.3;
    }

    .poll-options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .poll-option {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .poll-bar {
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 0%;
      background: linear-gradient(90deg, rgba(168, 85, 247, 0.35) 0%, rgba(168, 85, 247, 0.2) 100%);
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 11px;
      z-index: 1;
      pointer-events: none;
    }

    .poll-left-content {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .poll-result-info {
      position: relative;
      z-index: 2;
      display: none;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .poll-percent { color: var(--purple-light); font-weight: 800; }
    .poll-count { color: var(--subtext); font-size: 0.75rem; font-weight: 500; }

    .poll-option:hover, .poll-option:active {
      background: rgba(168, 85, 247, 0.1);
      border-color: rgba(168, 85, 247, 0.4);
    }

    .poll-option.selected {
      border-color: var(--purple-main);
      background: rgba(168, 85, 247, 0.15);
    }

    .poll-radio {
      width: 20px; height: 20px;
      border-radius: 50%;
      border: 2px solid var(--subtext);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .poll-radio-inner {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--purple-light);
      display: none;
    }

    .poll-option.selected .poll-radio-inner { display: block; }

    .poll-avatar {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; flex-shrink: 0;
    }

    .poll-name { font-weight: 700; font-size: 0.9rem; color: #ffffff; }

    .poll-option.voted {
      border: 1.5px solid var(--purple-light) !important;
      background: rgba(168, 85, 247, 0.12) !important;
      box-shadow: 0 0 14px rgba(168, 85, 247, 0.2);
    }

    .poll-option.voted .poll-radio {
      border-color: var(--purple-light) !important;
      background-color: var(--purple-main) !important;
    }

    .poll-option.voted .poll-radio::after {
      content: "✓"; color: #ffffff; font-weight: 900; font-size: 11px;
    }

    .poll-vote-btn {
      width: 100%; padding: 12px; border-radius: 12px;
      background: var(--purple-gradient); border: none;
      color: #ffffff; font-weight: 800; font-size: 0.9rem;
      cursor: pointer; margin-top: 4px;
      box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
    }

    .poll-vote-btn:disabled {
      background: rgba(255, 255, 255, 0.08) !important;
      color: var(--subtext) !important; cursor: not-allowed !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important; box-shadow: none !important;
    }

    /* --- WIDGET BREAKING NEWS --- */
    .breaking-news-card {
      background: linear-gradient(180deg, rgba(45, 12, 24, 0.6) 0%, rgba(20, 15, 29, 0.95) 100%);
      border: 1px solid rgba(255, 42, 75, 0.4);
      border-radius: 20px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    }

    @keyframes blink-red {
      0%, 100% {
        opacity: 1;
        text-shadow: 0 0 10px rgba(255, 42, 75, 0.8), 0 0 20px rgba(255, 42, 75, 0.4);
      }
      50% {
        opacity: 0.3;
        text-shadow: none;
      }
    }

    .breaking-header {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--accent-red);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      animation: blink-red 1.2s infinite ease-in-out;
    }

    .breaking-title {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--text);
    }

    .news-media {
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
    }

    .news-media img {
      width: 100%;
      height: auto;
      display: block;
    }

    .media-overlay-text {
      position: absolute;
      bottom: 12px;
      left: 0;
      right: 0;
      text-align: center;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      padding: 6px 10px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .news-description {
      font-size: 0.85rem;
      line-height: 1.45;
      color: #d2c8e0;
      font-weight: 500;
    }

    .section-title-news {
      font-weight: 700;
      color: var(--text);
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Rankingi */
    .rankings-list { display: flex; flex-direction: column; gap: 10px; }

    .card {
      background: var(--card-bg); border-radius: 14px;
      padding: 12px 14px; display: flex; align-items: center;
      justify-content: space-between; border: 1px solid rgba(255, 255, 255, 0.06);
      cursor: pointer; transition: all 0.2s ease;
    }

    .card:hover, .card:active {
      background: rgba(168, 85, 247, 0.1); border-color: var(--purple-main);
      box-shadow: 0 0 16px rgba(168, 85, 247, 0.3);
    }

    .card-left { display: flex; align-items: center; gap: 12px; }

    .rank-box {
      width: 36px; height: 36px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 1rem; color: #ffffff;
      background: rgba(255, 255, 255, 0.1); flex-shrink: 0;
    }

    .rank-1 { background: linear-gradient(180deg, #facc15 0%, #ca8a04 100%); color: #000; }
    .rank-2 { background: linear-gradient(180deg, #f1f5f9 0%, #94a3b8 100%); color: #000; }
    .rank-3 { background: linear-gradient(180deg, #d97706 0%, #78350f 100%); color: #fff; }

    .avatar {
      width: 44px; height: 44px; border-radius: 10px;
      background: rgba(255, 255, 255, 0.08); object-fit: cover;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; color: var(--subtext);
    }

    .info { display: flex; flex-direction: column; }
    .name { font-size: 0.95rem; font-weight: 700; color: var(--text); }
    .subtext { font-size: 0.75rem; color: var(--subtext); margin-top: 2px; }

    .card-right { display: flex; align-items: center; gap: 8px; }

    .aura-pill {
      font-size: 0.8rem; font-weight: 800; padding: 4px 8px; border-radius: 8px;
      background: rgba(168, 85, 247, 0.15); color: var(--purple-light);
      border: 1px solid rgba(168, 85, 247, 0.3);
    }

    .aura-pill.locked { background: rgba(255, 255, 255, 0.08); color: var(--subtext); border: none; }
    .arrow { font-size: 1.3rem; color: #4b5563; font-weight: bold; }

    /* Hall of Fame */
    .hof-section { display: flex; flex-direction: column; gap: 16px; margin-top: 10px; }
    .hof-header { display: flex; flex-direction: column; gap: 4px; }
    .hof-title { font-size: 1.2rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 8px; }
    .hof-subtitle { font-size: 0.8rem; color: var(--subtext); }

    .hof-card {
      background: #0d0c14; border: 1px solid #ca8a04; border-radius: 16px;
      overflow: hidden; display: flex; flex-direction: column;
      box-shadow: 0 4px 20px rgba(202, 138, 4, 0.15);
    }

    .hof-img-wrapper { position: relative; width: 100%; height: 320px; overflow: hidden; background: rgba(255,255,255,0.05); }
    .hof-img { width: 100%; height: 100%; object-fit: cover; }
    .legend-badge {
      position: absolute; top: 12px; right: 12px; background: rgba(202, 138, 4, 0.3);
      border: 1px solid #facc15; color: #facc15; font-size: 0.7rem; font-weight: 800;
      padding: 4px 10px; border-radius: 12px; backdrop-filter: blur(6px);
    }

    .hof-content { padding: 16px; display: flex; flex-direction: column; gap: 4px; }
    .hof-name { font-size: 1.15rem; font-weight: 800; color: #facc15; }
    .hof-role { font-size: 0.85rem; font-weight: 600; color: #eab308; }
    .hof-desc { font-size: 0.8rem; color: var(--subtext); margin-top: 6px; line-height: 1.4; }

    /* Społeczność */
    .owner-badge {
  color: #2563eb; /* Ładny, czytelny odcień niebieskiego */
  font-weight: bold;
  font-size: 0.85em;
  margin-left: 6px;
  display: inline-block;
    }

    .chad-badge {
  color: #facc15; /* Żółto-złoty odcień */
  font-weight: 800;
  font-size: 0.85em;
  margin-left: 6px;
  display: inline-block;
    }
    
    .user-auth-bar {
      background: #100d1a; border: 1px solid rgba(168, 85, 247, 0.25);
      border-radius: 14px; padding: 12px 16px; display: flex;
      align-items: center; justify-content: space-between;
    }

    .user-info-text { font-size: 0.85rem; font-weight: 700; color: #fff; }

    .auth-btn-small {
      background: var(--purple-gradient); border: none; color: #fff;
      font-size: 0.78rem; font-weight: 800; padding: 6px 12px;
      border-radius: 8px; cursor: pointer; transition: opacity 0.2s;
    }

    .auth-btn-small:hover { opacity: 0.9; }

    .delete-btn-admin {
      background: #ef4444; color: white; border: none; font-size: 0.7rem;
      padding: 2px 6px; border-radius: 4px; cursor: pointer; margin-left: 8px;
    }

    .create-post-card {
      position: relative;
      background: var(--card-bg); border: 1px solid rgba(168, 85, 247, 0.2);
      border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 10px;
      overflow: hidden;
    }

    .post-lock-overlay {
      position: absolute;
      inset: 0;
      background: rgba(12, 10, 20, 0.88);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      z-index: 20;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px dashed rgba(168, 85, 247, 0.4);
    }

    .post-lock-overlay:hover {
      background: rgba(12, 10, 20, 0.94);
      border-color: var(--purple-light);
    }

    .post-lock-icon { font-size: 2.2rem; }
    .post-lock-text {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--purple-light);
      text-align: center;
    }

    .post-textarea {
      width: 100%; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px; padding: 10px; color: #fff; font-size: 0.85rem;
      resize: vertical; min-height: 70px; outline: none;
    }

    .post-textarea:focus { border-color: var(--purple-main); }

    .file-input-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: var(--purple-light);
      cursor: pointer;
      background: rgba(168, 85, 247, 0.1);
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(168, 85, 247, 0.25);
    }

    .posts-feed { display: flex; flex-direction: column; gap: 14px; }

    .post-item {
      background: var(--card-bg); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px;
    }

    .post-header { display: flex; justify-content: space-between; align-items: center; }
    .post-author { font-size: 0.9rem; font-weight: 800; color: var(--purple-light); }
    .post-time { font-size: 0.7rem; color: var(--subtext); }
    .post-body { font-size: 0.88rem; color: #fff; line-height: 1.4; word-break: break-word; }
    .post-img { width: 100%; border-radius: 8px; margin-top: 6px; margin-bottom: 6px; max-height: 320px; object-fit: cover; }

    .translated-box {
      font-size: 0.82rem; color: var(--purple-light); font-style: italic;
      background: rgba(168, 85, 247, 0.1); padding: 6px 8px; border-radius: 8px; margin-top: 4px;
      line-height: 1.35; display: none;
    }

    .comments-section {
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 10px; margin-top: 4px; display: flex; flex-direction: column; gap: 8px;
    }

    .comment-item {
      background: rgba(0, 0, 0, 0.25); border-radius: 8px;
      padding: 8px 10px; display: flex; flex-direction: column; gap: 4px;
      border-left: 2px solid var(--purple-main);
    }

    .comment-header { display: flex; justify-content: space-between; font-size: 0.75rem; }
    .comment-author { font-weight: 700; color: #e0e0e0; }
    .comment-time { color: var(--subtext); }
    .comment-text { font-size: 0.82rem; color: #d1d5db; line-height: 1.3; }

    .translate-btn {
      align-self: flex-start; background: none; border: none;
      color: var(--purple-light); font-size: 0.72rem; font-weight: 700;
      cursor: pointer; padding: 2px 0; display: inline-flex; align-items: center; gap: 4px;
      opacity: 0.85; transition: opacity 0.2s; margin-top: 2px;
    }

    .translate-btn:hover { opacity: 1; text-decoration: underline; }

    .comment-input-box { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }

    .comment-input {
      flex: 1; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px; padding: 6px 10px; color: #fff; font-size: 0.78rem; outline: none;
    }

    .comment-input:focus { border-color: var(--purple-main); }

    /* Modale */
    .modal {
      display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(6px);
      align-items: center; justify-content: center; padding: 20px; z-index: 2000;
    }

    .modal-content {
      background: #12101c; width: 100%; max-width: 360px; border-radius: 18px;
      padding: 24px; position: relative; border: 1px solid var(--purple-main);
      text-align: center; box-shadow: 0 0 25px rgba(168, 85, 247, 0.25);
    }

    .close-btn {
      position: absolute; top: 12px; right: 16px; font-size: 1.5rem;
      background: none; border: none; color: var(--subtext); cursor: pointer;
    }

    .modal-avatar {
      width: 90px; height: 90px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.1); margin: 0 auto 12px auto;
      object-fit: cover; display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem; border: 2px solid var(--purple-main);
    }

    .modal-stats {
      display: flex; justify-content: space-around; background: rgba(0, 0, 0, 0.3);
      padding: 10px; border-radius: 12px; margin: 12px 0; border: 1px solid rgba(168, 85, 247, 0.15);
    }

    .stat-box { display: flex; flex-direction: column; align-items: center; }
    .stat-title { font-size: 0.7rem; color: var(--subtext); text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-value { font-size: 1.05rem; font-weight: 800; color: var(--purple-light); margin-top: 2px; }

    .vote-btn {
      background: var(--purple-gradient); color: #fff; border: none;
      padding: 10px 18px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;
      margin-top: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
      box-shadow: 0 4px 12px rgba(168, 85, 247, 0.35);
    }

    .vote-btn.voted { background: rgba(255, 255, 255, 0.1); color: var(--subtext); box-shadow: none; }
    .modal-body { margin-top: 12px; font-size: 0.85rem; color: var(--subtext); line-height: 1.4; min-height: 30px; }

    .auth-input {
      width: 100%; padding: 10px; margin-bottom: 10px; background: rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff;
      font-size: 0.85rem; outline: none;
    }

    .mod-badge { color:#22c55e; font-weight:800; font-size:0.85em; margin-left:6px; display:inline-block; }
    .role-admin { background:#100d1a; border:1px solid rgba(168,85,247,0.25); border-radius:14px; padding:10px 14px; }
    .role-admin summary { cursor:pointer; font-weight:800; font-size:0.85rem; color:var(--purple-light); }
    .news-preview { max-width:100%; max-height:160px; border-radius:8px; display:none; object-fit:cover; }

    .tabs { flex-wrap: wrap; row-gap: 2px; }
    @media (max-width: 480px) { .tabs { gap: 0; } .tab { padding: 6px 4px; font-size: 0.68rem; gap: 2px; white-space: nowrap; } }

    .trend { font-size: 0.72rem; font-weight: 800; }
    .trend.up { color: #22c55e; }
    .trend.down { color: #ef4444; }
    .trend.same { color: var(--subtext); }

    .mode-switch { display: flex; gap: 8px; }
    .mode-btn {
      flex: 1; padding: 9px 6px; border-radius: 12px; border: 1px solid rgba(168,85,247,0.3);
      background: var(--card-bg); color: var(--subtext); font-weight: 800; font-size: 0.8rem; cursor: pointer;
    }
    .mode-btn.active { background: var(--purple-gradient); color: #fff; border-color: transparent; }

    .farm-box { display: flex; gap: 10px; }
    .farm-item {
      flex: 1; background: var(--card-bg); border: 1px solid rgba(34,197,94,0.35); border-radius: 14px;
      padding: 10px 8px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0;
    }
    .farm-label { font-size: 0.66rem; color: var(--subtext); text-transform: uppercase; letter-spacing: 0.4px; }
    .farm-name { font-weight: 800; font-size: 0.9rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .farm-val { font-weight: 800; font-size: 0.8rem; color: #22c55e; }
    .farm-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #22c55e; }

    .streak-box {
      background: var(--card-bg); border: 1px solid rgba(250,204,21,0.35); border-radius: 14px;
      padding: 10px 12px; font-size: 0.82rem; display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .streak-badge { color: var(--gold-accent); font-weight: 800; font-size: 0.85em; margin-left: 6px; display: inline-block; }
    .subtext-s { color: var(--subtext); font-size: 0.72rem; }

    .duel-box { display: none; flex-direction: column; gap: 10px; }
    .duel-title { font-weight: 800; text-align: center; font-size: 0.95rem; }
    .duel-row { display: flex; align-items: stretch; gap: 8px; }
    .duel-card {
      flex: 1; min-width: 0; background: var(--card-bg); border: 1px solid rgba(168,85,247,0.3); border-radius: 16px;
      padding: 10px; display: flex; flex-direction: column; gap: 6px; text-align: center; cursor: pointer; transition: all .15s ease;
    }
    .duel-card:active { transform: scale(0.97); border-color: var(--purple-main); box-shadow: 0 0 16px rgba(168,85,247,0.4); }
    .duel-img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px; background: rgba(255,255,255,0.05); }
    .duel-ph { display: flex; align-items: center; justify-content: center; font-size: 2.4rem; }
    .duel-name { font-weight: 800; font-size: 0.95rem; }
    .duel-sub { font-size: 0.72rem; color: var(--subtext); }
    .duel-vs { align-self: center; font-weight: 900; color: var(--purple-light); font-size: 0.9rem; }
    .duel-feedback { text-align: center; font-size: 0.82rem; color: var(--purple-light); min-height: 20px; }

    .power-row { display: none; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 4px; }
    .power-btn { background: linear-gradient(135deg, #f59e0b, #b45309); box-shadow: 0 4px 12px rgba(245,158,11,0.35); }
    .power-btn.mega { background: linear-gradient(135deg, #06b6d4, #7c3aed); box-shadow: 0 4px 12px rgba(124,58,237,0.35); }
    .power-btn:disabled { opacity: 0.55; box-shadow: none; }
    .power-hint { font-size: 0.75rem; color: var(--subtext); cursor: pointer; text-decoration: underline; margin-top: 8px; }
    .modal-duel { font-size: 0.78rem; color: var(--purple-light); margin-top: 8px; }

    .arch-month { background: var(--card-bg); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .arch-month-title { font-weight: 800; color: var(--purple-light); text-transform: capitalize; }
    .arch-row { display: flex; align-items: center; gap: 10px; }
    .arch-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; background: rgba(255,255,255,0.06); }
    .arch-ph { display: flex; align-items: center; justify-content: center; }
    .arch-label { font-size: 0.68rem; color: var(--subtext); text-transform: uppercase; letter-spacing: 0.3px; }
    .arch-name { font-weight: 800; font-size: 0.92rem; }
    .arch-val { font-size: 0.78rem; color: var(--gold-accent); font-weight: 700; }
    .arch-week { background: var(--card-bg); border: 1px solid rgba(250,204,21,0.25); border-radius: 14px; padding: 10px 12px; }
  </style>
</head>
<body>

  <div class="app-container">
    <header>
      <div class="header-top">
        <div class="header-logo">
          <img src="MORPH.jpg" alt="Logo">
        </div>
        <h1>POLISH CHAD RANKINGS</h1>
        <div class="lang-switch">
          <span class="flag-btn active" id="flag-pl" onclick="setLanguage('pl')">🇵🇱</span>
          <span class="flag-btn" id="flag-en" onclick="setLanguage('en')">🇬🇧</span>
        </div>
      </div>

      <div class="tabs">
        <span class="tab active" id="txt-tab-rankings" onclick="switchTab('rankings')">📋 Rankingi</span>
        <span class="tab" id="txt-tab-news" onclick="switchTab('news')">📰 Aktualności</span>
        <span class="tab" id="txt-tab-community" onclick="switchTab('community')">💬 Społeczność</span>
        <span class="tab" id="txt-tab-archive" onclick="switchTab('archive')">🏆 Archiwum</span>
      </div>
    </header>

    <main class="content">
      <!-- WIDOK RANKINGU -->
      <div id="view-rankings" class="tab-view">
        <section class="hero-section">
          <div class="badge-updated" id="timer-text">⏱️ Ładowanie timera...</div>
          <p class="hero-description" id="txt-hero">
            Cotygodniowo aktualizowany ranking najbardziej wpływowych chadów w polskiej społeczności.
          </p>
          <div class="badge-verified" id="txt-verified">🎗️ Zweryfikowano przez Polish Chad Association</div>
        </section>

        <!-- Ankieta Społeczna -->
        <section class="poll-card">
          <div class="poll-badge">
            <span>📊</span>
            <span id="txt-poll-badge">ANKIETA SPOŁECZNA</span>
          </div>
          <h2 class="poll-title" id="txt-poll-title">Kto powinien zająć miejsce #1?</h2>
          <div class="poll-subtitle" id="txt-poll-sub">0 oddanych głosów</div>

          <div class="poll-options">
            <div class="poll-option" id="poll-opt-1" onclick="selectPollOption('chad_1')">
              <div class="poll-bar" id="poll-bar-1"></div>
              <div class="poll-left-content">
                <div class="poll-radio"><div class="poll-radio-inner"></div></div>
                <div id="poll-avatar-1" class="poll-avatar">🗿</div>
                <span class="poll-name" id="poll-name-1">Luka</span>
              </div>
              <div class="poll-result-info" id="poll-result-1">
                <span class="poll-percent" id="poll-pct-1">0%</span>
                <span class="poll-count" id="poll-cnt-1">(0)</span>
              </div>
            </div>

            <div class="poll-option" id="poll-opt-2" onclick="selectPollOption('chad_2')">
              <div class="poll-bar" id="poll-bar-2"></div>
              <div class="poll-left-content">
                <div class="poll-radio"><div class="poll-radio-inner"></div></div>
                <div id="poll-avatar-2" class="poll-avatar">🗿</div>
                <span class="poll-name" id="poll-name-2">Ten od Midasa</span>
              </div>
              <div class="poll-result-info" id="poll-result-2">
                <span class="poll-percent" id="poll-pct-2">0%</span>
                <span class="poll-count" id="poll-cnt-2">(0)</span>
              </div>
            </div>
          </div>

          <button class="poll-vote-btn" id="btnPollVote" onclick="castPollVote()">
            <span id="txt-poll-btn">Zagłosuj</span>
          </button>
        </section>

        <div id="breakingHome"></div>

        <!-- Przycisk Reset dostępny tylko dla Właściciela -->
<div id="ownerResetContainer" style="display: none; margin-bottom: 10px;">
  <button class="auth-btn-small" style="background: #ef4444; width: 100%; padding: 10px; font-size: 0.85rem; font-weight: 800;" onclick="triggerOwnerReset()">
    🔄 Resetuj ranking i przelicz głosy (Właściciel)
  </button>
</div>

        <div class="farm-box" id="farmBox" style="display:none;"></div>
        <div class="streak-box" id="streakBox" style="display:none;"></div>

        <div class="mode-switch">
          <button class="mode-btn active" id="modeList" onclick="setRankMode('list')">📋 Lista</button>
          <button class="mode-btn" id="modeDuel" onclick="setRankMode('duel')">⚔️ Matchup</button>
          <button class="mode-btn" id="btnShareOpen" onclick="openShare()">📸 TOP 3</button>
        </div>

        <section class="duel-box" id="duelBox">
          <div class="duel-title" id="duelTitle">Kto jest lepszy?</div>
          <div class="duel-row">
            <div class="duel-card" id="duelA" onclick="pickDuel(0)"></div>
            <div class="duel-vs">VS</div>
            <div class="duel-card" id="duelB" onclick="pickDuel(1)"></div>
          </div>
          <div class="duel-feedback" id="duelFeedback"></div>
        </section>

        <section class="rankings-list" id="rankings"></section>

        <section class="hof-section">
          <div class="hof-header">
            <h2 class="hof-title" id="txt-hof-title">👑 Sala Sław</h2>
            <p class="hof-subtitle" id="txt-hof-sub">Legendy wycofane z aktywnego rankingu.</p>
          </div>
          <div id="hofContainer" style="display: flex; flex-direction: column; gap: 16px;"></div>
        </section>
      </div>

      <!-- WIDOK NEWS -->
      <div id="view-news" class="tab-view hidden">
        <h1 class="page-title" id="txt-news-page-title" style="font-size: 1.3rem; margin-bottom: 5px;">AKTUALNOŚCI</h1>

        <!-- Formularz wpisu (widoczny tylko dla CHAD / MOD / WŁAŚCICIEL) -->
        <div class="create-post-card" id="newsCreateCard" style="display:none;">
          <div style="font-size:0.85rem;font-weight:800;color:var(--purple-light);">✍️ Nowy wpis / New post</div>
          <select id="newsLang" class="auth-input" style="margin-bottom:0;">
            <option value="pl">🇵🇱 Piszę po polsku</option>
            <option value="en">🇬🇧 I write in English</option>
          </select>
          <input class="auth-input" id="newsTitleInput" maxlength="150" placeholder="Tytuł / Title" style="margin-bottom:0;">
          <textarea class="post-textarea" id="newsDescInput" maxlength="4000" placeholder="Opis / Description"></textarea>
          <input class="auth-input" id="newsCaptionInput" maxlength="150" placeholder="Napis na zdjęciu / Image caption" style="margin-bottom:0;">
          <label class="file-input-btn" style="align-self:flex-start;">🖼️ <span>Zdjęcie z galerii / Image</span>
            <input type="file" id="newsImage" accept="image/*" style="display:none;" onchange="previewImage(this,'newsImagePreview','newsImageName')">
          </label>
          <span id="newsImageName" style="font-size:0.72rem;color:var(--purple-light);"></span>
          <img id="newsImagePreview" class="news-preview" alt="">
          <label style="font-size:0.8rem;display:flex;gap:8px;align-items:center;">
            <input type="checkbox" id="newsAsBreaking"> 🚨 Ustaw jako Breaking News (stary trafi do aktualności)
          </label>
          <button class="auth-btn-small" id="btnNewsPublish" onclick="publishNews()" style="padding:10px;">Opublikuj</button>
        </div>

        <div id="breakingTab"></div>

        <div class="section-title-news" id="txt-trending-news-title" style="margin-top: 10px;">🔥 Popularne wiadomości</div>
        <div class="posts-feed" id="newsFeed"></div>
      </div>

      <!-- WIDOK ARCHIWUM -->
      <div id="view-archive" class="tab-view hidden">
        <h1 class="page-title" id="archTitle" style="font-size: 1.3rem; margin-bottom: 5px;">🏆 ARCHIWUM</h1>
        <div id="archiveContent" style="display:flex;flex-direction:column;gap:12px;"></div>
      </div>

      <!-- WIDOK SPOŁECZNOŚCI -->
      <div id="view-community" class="tab-view hidden">
        <div class="user-auth-bar">
          <span class="user-info-text" id="userAuthStatus">Niezalogowany</span>
          <button class="auth-btn-small" id="btnAuthAction" onclick="handleAuthAction()">Zaloguj / Zarejestruj</button>
        </div>

        <!-- Panel ról (tylko Właściciel) -->
        <details class="role-admin" id="roleAdmin" style="display:none;">
          <summary>🛡️ Role: CHAD / MOD</summary>
          <div id="roleAdminList" style="margin-top:8px;"></div>
        </details>

        <!-- Tworzenie wpisu -->
        <div class="create-post-card" id="postCreateCard">
          <div class="post-lock-overlay" id="postLockOverlay" onclick="openAuthModal()">
            <span class="post-lock-icon">🔒</span>
            <span class="post-lock-text" id="txt-lock-overlay">Zaloguj się, aby dodać wpis</span>
          </div>

          <textarea class="post-textarea" id="postInput" placeholder="Napisz coś na społeczności..."></textarea>
          
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
            <label class="file-input-btn">
              🖼️ <span id="txt-add-img">Dodaj zdjęcie</span>
              <input type="file" id="postImage" accept="image/*" style="display: none;" onchange="updateFileName(this, 'postImageName')">
            </label>
            <span id="postImageName" style="font-size: 0.72rem; color: var(--purple-light);"></span>
            <button class="auth-btn-small" onclick="createPost()" id="txt-publish-btn">Opublikuj</button>
          </div>
        </div>

        <div class="posts-feed" id="postsContainer"></div>
      </div>
    </main>
  </div>

  <!-- MODAL PROFILU CHADA -->
  <div class="modal" id="profileModal">
    <div class="modal-content">
      <button class="close-btn" onclick="closeModal()">&times;</button>
      <div id="modalAvatarContainer"></div>
      <h2 id="modalName"></h2>
      <p id="modalTitle" style="color: var(--subtext); font-size: 0.8rem; margin-top: 2px;"></p>
      
      <div class="modal-stats">
        <div class="stat-box">
          <span class="stat-title" id="st-rank">Ranga</span>
          <span class="stat-value" id="modalStatRank">#1</span>
        </div>
        <div class="stat-box">
          <span class="stat-title">Aura Score</span>
          <span class="stat-value" id="modalStatAura">99.9</span>
        </div>
        <div class="stat-box">
          <span class="stat-title" id="st-votes">Głosy</span>
          <span class="stat-value" id="modalStatVotes">0</span>
        </div>
      </div>

      <button class="vote-btn" id="btnVote" onclick="castVote()">
        <span id="txt-vote">🔥 Daj Głos</span>
      </button>

      <div class="power-row" id="powerBox">
        <button class="vote-btn power-btn" id="btnSuper" onclick="castPower('super')">⚡ Super-Głos (+2)</button>
        <button class="vote-btn power-btn mega" id="btnMega" onclick="castPower('mega')">💎 Mega-Głos (+5)</button>
        <div class="power-hint" id="powerHint" onclick="openAuthModal()" style="display:none;width:100%;"></div>
      </div>
      <div class="modal-duel" id="modalDuel"></div>

      <div class="modal-body" id="modalDesc"></div>
    </div>
  </div>

  <!-- MODAL KARTY TOP 3 -->
  <div class="modal" id="shareModal">
    <div class="modal-content" style="max-height:92vh;overflow:auto;">
      <button class="close-btn" onclick="closeShare()">&times;</button>
      <h3 id="shareTitle" style="margin-bottom:6px;">📸 Twoje TOP 3</h3>
      <div id="shareSub" style="font-size:0.75rem;color:var(--subtext);">Wybierz swoich faworytów i wygeneruj kartę na Instagram / TikTok.</div>
      <div id="sharePickers" style="display:flex;flex-direction:column;gap:6px;margin:12px 0;"></div>
      <button class="auth-btn-small" id="btnGenCard" onclick="generateCard()" style="width:100%;padding:10px;">Generuj kartę</button>
      <img id="shareImg" alt="" style="display:none;width:100%;border-radius:12px;margin-top:12px;">
      <div id="shareActions" style="display:none;gap:8px;margin-top:10px;justify-content:center;flex-wrap:wrap;">
        <button class="auth-btn-small" id="btnShareNative" onclick="shareCard()">📤 Udostępnij</button>
        <button class="auth-btn-small" id="btnDownload" onclick="downloadCard()">⬇️ Pobierz PNG</button>
      </div>
    </div>
  </div>

  <!-- MODAL EDYCJI AKTUALNOŚCI -->
  <div class="modal" id="newsEditModal">
    <div class="modal-content" style="max-height:90vh;overflow:auto;text-align:left;">
      <button class="close-btn" onclick="closeNewsEdit()">&times;</button>
      <h3 style="margin-bottom:12px;">✏️ Edycja / Edit</h3>
      <div style="font-weight:800;font-size:0.8rem;color:var(--purple-light);margin-bottom:6px;">🇵🇱 Polski</div>
      <input class="auth-input" id="editTitle_pl" maxlength="150" placeholder="Tytuł">
      <textarea class="post-textarea" id="editDesc_pl" maxlength="4000" placeholder="Opis" style="margin-bottom:10px;"></textarea>
      <input class="auth-input" id="editCap_pl" maxlength="150" placeholder="Napis na zdjęciu">
      <div style="font-weight:800;font-size:0.8rem;color:var(--purple-light);margin:10px 0 6px;">🇬🇧 English</div>
      <input class="auth-input" id="editTitle_en" maxlength="150" placeholder="Title">
      <textarea class="post-textarea" id="editDesc_en" maxlength="4000" placeholder="Description" style="margin-bottom:10px;"></textarea>
      <input class="auth-input" id="editCap_en" maxlength="150" placeholder="Image caption">
      <div style="margin:10px 0;display:flex;flex-direction:column;gap:6px;">
        <label class="file-input-btn" style="align-self:flex-start;">🖼️ <span>Zmień zdjęcie / Replace image</span>
          <input type="file" id="editImage" accept="image/*" style="display:none;" onchange="updateFileName(this,'editImageName')">
        </label>
        <span id="editImageName" style="font-size:0.72rem;color:var(--purple-light);"></span>
        <label style="font-size:0.78rem;display:flex;gap:8px;align-items:center;">
          <input type="checkbox" id="editRemoveImage"> Usuń zdjęcie / Remove image
        </label>
      </div>
      <button class="auth-btn-small" id="btnSaveEdit" style="width:100%;padding:10px;" onclick="saveNewsEdit()">Zapisz / Save</button>
    </div>
  </div>

  <!-- MODAL LOGOWANIA / REJESTRACJI -->
  <div class="modal" id="authModal">
    <div class="modal-content">
      <button class="close-btn" onclick="closeAuthModal()">&times;</button>
      <h2 id="txt-auth-title" style="margin-bottom: 14px;">Konto Chad</h2>
      <input type="text" class="auth-input" id="authUsername" placeholder="Twój Nick / Pseudonim">
      <input type="email" class="auth-input" id="authEmail" placeholder="E-mail">
      <input type="password" class="auth-input" id="authPassword" placeholder="Hasło">
      <div style="display:flex; gap:10px; margin-top:10px;">
        <button class="auth-btn-small" style="flex:1; padding: 10px;" onclick="handleLogin()" id="txt-login-btn">Zaloguj</button>
        <button class="auth-btn-small" style="flex:1; padding: 10px; background: rgba(255,255,255,0.1);" onclick="handleRegister()" id="txt-register-btn">Zarejestruj</button>
      </div>
    </div>
  </div>

  <script>
    let currentLang = "pl";
    let activeChadId = null;
    let currentUser = null;
    let currentVotesCache = {};
    let selectedPollCandidateId = null;
    let postsDataCache = {};
    let currentResetVersion = 0;
    
    const ADMIN_EMAIL = "kplatek.2020@gmail.com";
    const IMGBB_API_KEY = "b2443cd9b7815f2f3e2909250ec3bce3";
    const VOTE_COOLDOWN = 48 * 60 * 1000; // 48 minut
    let modalTimerInterval = null;
    

    

    const firebaseConfig = {
      apiKey: "AIzaSyCJDcay4pyauLgGQLloTrf1kp2GjXoQmTA",
      authDomain: "polish-chad-rankings.firebaseapp.com",
      databaseURL: "https://polish-chad-rankings-default-rtdb.europe-west1.firebasedatabase.app",
      projectId: "polish-chad-rankings",
      storageBucket: "polish-chad-rankings.appspot.com",
      messagingSenderId: "941798583866",
      appId: "1:941798583866:web:d79633db32004e07c74f03"
    };

    firebase.initializeApp(firebaseConfig);
const db = firebase.database();
const auth = firebase.auth();

// ===== Stan, role i autoryzacja =====
    // Konta anonimowe służą wyłącznie do głosowania i NIE liczą się jako zalogowani.
    let rolesCache = {};
    let usersCache = {};
    let newsCache = {};
    let breakingCache = null;
    let editTarget = null;
    let serverOffset = 0;
    let registering = false;
    let usersListenerOn = false;
    let textRegistry = [];
    function nowMs() { return Date.now() + serverOffset; }

    db.ref('.info/serverTimeOffset').on('value', function(s) { serverOffset = s.val() || 0; });

    function getNick(u) {
      return String(u.displayName || (u.email || "user").split("@")[0]).slice(0, 40);
    }

    function syncUserProfile(u) {
      db.ref('users/' + u.uid).set({ email: String(u.email || "").toLowerCase(), nick: getNick(u) }).catch(function() {});
      if (u.email === ADMIN_EMAIL && rolesCache[u.uid] !== 'owner') {
        db.ref('roles/' + u.uid).set('owner').catch(function() {});
      }
    }

    auth.onAuthStateChanged((user) => {
      if (!user) {
        currentUser = null;
        updateAuthUI();
        renderPosts();
        auth.signInAnonymously().catch(err => console.error("Anonymous sign-in:", err));
        return;
      }
      currentUser = user.isAnonymous ? null : user;
      if (currentUser && !registering) syncUserProfile(currentUser);
      updateAuthUI();
      renderPosts();
    });

    const pollConfig = {
      targetRank: 1,
      candidate1Id: "chad_1",
      candidate2Id: "chad_2",
      active: false // false = Ankieta Zakończona
    };

