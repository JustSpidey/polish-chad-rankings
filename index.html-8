    function getWeekIdentifier() {
      const now = new Date();
      const nextSunday = new Date(now);
      const daysUntilSunday = (7 - now.getDay()) % 7;
      nextSunday.setDate(now.getDate() + daysUntilSunday);
      nextSunday.setHours(23, 59, 59, 0);

      const y = nextSunday.getFullYear();
      const m = String(nextSunday.getMonth() + 1).padStart(2, '0');
      const d = String(nextSunday.getDate()).padStart(2, '0');
      return "WEEK_" + y + "_" + m + "_" + d;
    }

    function isPollRevealed() {
      const c1 = chadsData.find(c => c.id === pollConfig.candidate1Id);
      const c2 = chadsData.find(c => c.id === pollConfig.candidate2Id);
      return !!(c1 && c2 && !c1.locked && !c2.locked);
    }

    function switchTab(tabName) {
      document.getElementById("txt-tab-rankings").classList.toggle("active", tabName === 'rankings');
      document.getElementById("txt-tab-news").classList.toggle("active", tabName === 'news');
      document.getElementById("txt-tab-community").classList.toggle("active", tabName === 'community');

      document.getElementById("view-rankings").classList.toggle("hidden", tabName !== 'rankings');
      document.getElementById("view-news").classList.toggle("hidden", tabName !== 'news');
      document.getElementById("view-community").classList.toggle("hidden", tabName !== 'community');
      document.getElementById("txt-tab-archive").classList.toggle("active", tabName === 'archive');
      document.getElementById("view-archive").classList.toggle("hidden", tabName !== 'archive');
    }

        function renderRankings() {
      const container = document.getElementById("rankings");
      if (!container) return;
      container.innerHTML = "";

      // Kopia i posortowanie po randze (od 1 do N)
      const sortedChads = [...chadsData].sort((a, b) => a.rank - b.rank);

      sortedChads.forEach(function(chad) {
        const card = document.createElement("div");
        card.className = "card";
        card.onclick = function() { openModal(chad); };

        let rankClass = "rank-box";
        if (chad.rank === 1) rankClass += " rank-1";
        else if (chad.rank === 2) rankClass += " rank-2";
        else if (chad.rank === 3) rankClass += " rank-3";

        const isLocked = chad.locked;
        const nameText = isLocked ? i18n[currentLang].unrevealedName : chad.name;
        const subText = isLocked 
          ? i18n[currentLang].unrevealedTitle 
          : (currentLang === "pl" ? chad.titlePl : chad.titleEn);

        const avatarHTML = (!isLocked && chad.img) 
          ? '<img src="' + chad.img + '" class="avatar" alt="Avatar">'
          : '<div class="avatar">❓</div>';

        const auraText = getAuraText(chad);
        const auraClass = isLocked ? "aura-pill locked" : "aura-pill";

        card.innerHTML = 
          '<div class="card-left">' +
            '<div class="' + rankClass + '">' + chad.rank + '</div>' +
            avatarHTML +
            '<div class="info">' +
              '<span class="name">' + nameText + '</span>' +
              '<span class="subtext">' + subText + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="card-right">' +
            trendHTML(chad) + '<span class="' + auraClass + '">' + auraText + '</span>' +
            '<span class="arrow">&rsaquo;</span>' +
          '</div>';

        container.appendChild(card);
      });
    }

    function renderHallOfFame() {
      const container = document.getElementById("hofContainer");
      if (!container) return;
      container.innerHTML = "";

      hallOfFameData.forEach(function(item) {
        const role = currentLang === "pl" ? item.rolePl : item.roleEn;
        const desc = currentLang === "pl" ? item.descPl : item.descEn;

        const card = document.createElement("div");
        card.className = "hof-card";
        card.innerHTML = 
          '<div class="hof-img-wrapper">' +
            '<img src="' + item.img + '" class="hof-img" alt="' + item.name + '">' +
            '<span class="legend-badge">' + i18n[currentLang].legendBadge + '</span>' +
          '</div>' +
          '<div class="hof-content">' +
            '<h3 class="hof-name">' + item.name + '</h3>' +
            '<span class="hof-role">' + role + '</span>' +
            '<p class="hof-desc">' + desc + '</p>' +
          '</div>';

        container.appendChild(card);
      });
    }

    function setupPollUI() {
      const c1 = chadsData.find(c => c.id === pollConfig.candidate1Id);
      const c2 = chadsData.find(c => c.id === pollConfig.candidate2Id);

      if (c1) {
        document.getElementById("poll-name-1").innerText = c1.name;
        const img1 = document.getElementById("poll-avatar-1");
        img1.innerHTML = c1.img ? '<img src="' + c1.img + '" style="width:100%;height:100%;border-radius:50%;object-fit:cover">' : "🗿";
      }

      if (c2) {
        document.getElementById("poll-name-2").innerText = c2.name;
        const img2 = document.getElementById("poll-avatar-2");
        img2.innerHTML = c2.img ? '<img src="' + c2.img + '" style="width:100%;height:100%;border-radius:50%;object-fit:cover">' : "🗿";
      }

      updatePollVotesCount();
      updatePollUI();
    }

    function selectPollOption(candidateId) {
  if (!pollConfig.active) return;

  const weekKey = getWeekIdentifier();
  if (localStorage.getItem("poll_voted_" + weekKey) === "1") return;

  selectedPollCandidateId = candidateId;
  updatePollUI();
    }
    
    function updatePollVotesCount() {
  // Jeśli ankieta jest wyłączona, odczytujemy wyłącznie zarchiwizowane dane
  const v1 = !pollConfig.active 
    ? (archivedPollVotes[pollConfig.candidate1Id] || 0) 
    : (currentVotesCache[pollConfig.candidate1Id] ?? archivedPollVotes[pollConfig.candidate1Id] ?? 0);

  const v2 = !pollConfig.active 
    ? (archivedPollVotes[pollConfig.candidate2Id] || 0) 
    : (currentVotesCache[pollConfig.candidate2Id] ?? archivedPollVotes[pollConfig.candidate2Id] ?? 0);

  const total = v1 + v2;

  const subElem = document.getElementById("txt-poll-sub");
  if (!pollConfig.active) {
    subElem.innerText = total + (currentLang === "pl" ? " oddanych głosów • Ankieta zakończona " : " votes cast • Poll closed ");
  } else {
    subElem.innerText = total + i18n[currentLang].pollVotesSub;
  }
    }
    
    function updatePollUI() {
  const opt1 = document.getElementById("poll-opt-1");
  const opt2 = document.getElementById("poll-opt-2");
  const btn = document.getElementById("btnPollVote");

  const bar1 = document.getElementById("poll-bar-1");
  const bar2 = document.getElementById("poll-bar-2");
  const res1 = document.getElementById("poll-result-1");
  const res2 = document.getElementById("poll-result-2");

  // Jeśli ankieta jest wyłączona, odczytujemy wyłącznie zarchiwizowane dane
  const v1 = !pollConfig.active 
    ? (archivedPollVotes[pollConfig.candidate1Id] || 0) 
    : (currentVotesCache[pollConfig.candidate1Id] ?? archivedPollVotes[pollConfig.candidate1Id] ?? 0);

  const v2 = !pollConfig.active 
    ? (archivedPollVotes[pollConfig.candidate2Id] || 0) 
    : (currentVotesCache[pollConfig.candidate2Id] ?? archivedPollVotes[pollConfig.candidate2Id] ?? 0);

  const total = v1 + v2;

  let pct1 = 0, pct2 = 0;
  if (total > 0) {
    pct1 = Math.round((v1 / total) * 100);
    pct2 = 100 - pct1;
  }
      
  // Wersja zablokowana – zawsze wyświetla stały wynik z archiwum i sztywny progress bar
  if (!pollConfig.active) {
    res1.style.display = "flex";
    res2.style.display = "flex";
    document.getElementById("poll-pct-1").innerText = pct1 + "%";
    document.getElementById("poll-cnt-1").innerText = "(" + v1 + ")";
    document.getElementById("poll-pct-2").innerText = pct2 + "%";
    document.getElementById("poll-cnt-2").innerText = "(" + v2 + ")";
    bar1.style.width = pct1 + "%";
    bar2.style.width = pct2 + "%";

    opt1.classList.remove("selected");
    opt2.classList.remove("selected");

    btn.disabled = true;
    document.getElementById("txt-poll-btn").innerText = currentLang === "pl" ? "🔒 Ankieta zakończona" : "🔒 Poll closed";
    return;
  }

  // Logika dla aktywnej ankiety
  const weekKey = getWeekIdentifier();
  const votedCandidate = localStorage.getItem("poll_voted_candidate_" + weekKey);
  const hasVoted = !!votedCandidate || localStorage.getItem("poll_voted_" + weekKey) === "1";

  opt1.classList.remove("selected", "voted");
  opt2.classList.remove("selected", "voted");

  if (hasVoted) {
    res1.style.display = "flex"; res2.style.display = "flex";
    document.getElementById("poll-pct-1").innerText = pct1 + "%";
    document.getElementById("poll-cnt-1").innerText = "(" + v1 + ")";
    document.getElementById("poll-pct-2").innerText = pct2 + "%";
    document.getElementById("poll-cnt-2").innerText = "(" + v2 + ")";
    bar1.style.width = pct1 + "%"; bar2.style.width = pct2 + "%";

    if (votedCandidate === pollConfig.candidate1Id) opt1.classList.add("voted");
    else if (votedCandidate === pollConfig.candidate2Id) opt2.classList.add("voted");

    btn.disabled = true;
    document.getElementById("txt-poll-btn").innerText = i18n[currentLang].pollBtnVoted;
  } else {
    res1.style.display = "none"; res2.style.display = "none";
    bar1.style.width = "0%"; bar2.style.width = "0%";

    if (selectedPollCandidateId === pollConfig.candidate1Id) opt1.classList.add("selected");
    else if (selectedPollCandidateId === pollConfig.candidate2Id) opt2.classList.add("selected");

    btn.disabled = !selectedPollCandidateId;
    document.getElementById("txt-poll-btn").innerText = i18n[currentLang].pollBtnVote;
  }
    }
      
  
async function castPollVote() {
  if (!pollConfig.active) return;
  if (!selectedPollCandidateId) return;

  // 1. Wymuś zalogowanie do oddania głosu
  if (!currentUser) {
    alert(currentLang === "pl" ? "Musisz być zalogowany, aby zagłosować!" : "You must be logged in to vote!");
    openAuthModal();
    return;
  }

  const weekKey = getWeekIdentifier();
  const uid = currentUser.uid;
  const userVoteRef = db.ref(`user_votes/${weekKey}/${selectedPollCandidateId}/${uid}`);

  try {
    // 2. Sprawdź w bazie danych, czy użytkownik już głosował w tym tygodniu
    const snapshot = await userVoteRef.once('value');
    if (snapshot.exists()) {
      alert(currentLang === "pl" ? "Już oddałeś głos w tej ankiecie!" : "You have already voted!");
      return;
    }

    // 3. Zapisz głos w uaktualnionej strukturze
    await userVoteRef.set(true);
    
    // 4. Zwiększ ogólny licznik o 1
    await db.ref('votes/' + selectedPollCandidateId).transaction(function(c) { 
      return (c || 0) + 1; 
    });

    localStorage.setItem("poll_voted_" + weekKey, "1");
    localStorage.setItem("poll_voted_candidate_" + weekKey, selectedPollCandidateId);

    updatePollVotesCount();
    updatePollUI();
  } catch (err) {
    alert((currentLang === "pl" ? "Błąd podczas oddawania głosu: " : "Voting error: ") + err.message);
  }
}
    
    
    function updateAuthUI() {
      const status = document.getElementById("userAuthStatus");
      const btn = document.getElementById("btnAuthAction");
      const overlay = document.getElementById("postLockOverlay");
      const ownerResetBtn = document.getElementById("ownerResetContainer");
      const isAdmin = isOwnerUser();

      if (ownerResetBtn) ownerResetBtn.style.display = isAdmin ? "block" : "none";

      if (currentUser) {
        const badge = isAdmin ? getOwnerBadgeHTML() : getBadgeHTML(currentUser.uid);
        status.innerHTML = esc(i18n[currentLang].loggedInAs) + "<b>" + esc(getNick(currentUser)) + "</b>" + badge + streakBadgeHTML();
        btn.innerText = i18n[currentLang].logoutBtn;
        if (overlay) overlay.style.display = "none";
      } else {
        status.innerText = i18n[currentLang].notLoggedIn;
        btn.innerText = i18n[currentLang].loginBtn;
        if (overlay) overlay.style.display = "flex";
      }

      const nc = document.getElementById("newsCreateCard");
      if (nc) nc.style.display = isStaffUser() ? "flex" : "none";
      const ra = document.getElementById("roleAdmin");
      if (ra) ra.style.display = isAdmin ? "block" : "none";
      if (isAdmin) ensureUsersListener();

      renderBreaking();
      renderNewsFeed();
    }

    function ensureUsersListener() {
      if (usersListenerOn || !isOwnerUser()) return;
      usersListenerOn = true;
      db.ref('users').on('value', function(s) {
        usersCache = s.val() || {};
        renderRoleAdmin();
      }, function() { usersListenerOn = false; });
    }

    function handleAuthAction() {
      if (currentUser) {
        auth.signOut();
      } else {
        openAuthModal();
      }
    }

    function openAuthModal() { document.getElementById("authModal").style.display = "flex"; }
    function closeAuthModal() { document.getElementById("authModal").style.display = "none"; }

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function(c) {
        return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
      });
    }
    function safeUrl(u) { return /^https:\/\//i.test(String(u || "")) ? String(u) : ""; }

    function getRoleByUid(uid) { return uid ? (rolesCache[uid] || null) : null; }

    function getOwnerBadgeHTML() {
      const label = currentLang === 'pl' ? '[WŁAŚCICIEL]' : '[OWNER]';
      return '<span class="owner-badge">' + label + '</span>';
    }
    function getChadBadgeHTML() { return '<span class="chad-badge">[CHAD]</span>'; }
    function getModBadgeHTML() { return '<span class="mod-badge">[MOD]</span>'; }
    function getBadgeHTML(uid) {
      const r = getRoleByUid(uid);
      if (r === "owner") return getOwnerBadgeHTML();
      if (r === "chad") return getChadBadgeHTML();
      if (r === "mod") return getModBadgeHTML();
      return "";
    }

    function isOwnerUser() { return !!currentUser && currentUser.email === ADMIN_EMAIL; }
    function isStaffUser() { return !!currentUser && (isOwnerUser() || !!getRoleByUid(currentUser.uid)); }
    function canEditEntry(e) { return !!currentUser && (isOwnerUser() || (isStaffUser() && e.uid === currentUser.uid)); }
    function getLocalized(e) { return e[currentLang] || e[e.origLang] || e.pl || e.en || {}; }

    function handleLogin() {
      const email = document.getElementById("authEmail").value.trim();
      const pass = document.getElementById("authPassword").value.trim();

      if (!email || !pass) return alert(currentLang === "pl" ? "Wypełnij e-mail i hasło!" : "Please fill in email and password!");

      auth.signInWithEmailAndPassword(email, pass)
        .then(() => closeAuthModal())
        .catch(err => alert((currentLang === "pl" ? "Błąd logowania: " : "Login error: ") + err.message));
    }

    function handleRegister() {
      const nick = document.getElementById("authUsername").value.trim();
      const email = document.getElementById("authEmail").value.trim();
      const pass = document.getElementById("authPassword").value.trim();

      if (!email || !pass) return alert(currentLang === "pl" ? "Wypełnij e-mail i hasło!" : "Please fill in email and password!");
      if (!nick) return alert(currentLang === "pl" ? "Wpisz swój nick!" : "Please enter your username!");
      if (nick.length > 40) return alert(currentLang === "pl" ? "Nick może mieć maks. 40 znaków." : "Username max 40 characters.");

      registering = true;
      auth.createUserWithEmailAndPassword(email, pass)
        .then((cred) => cred.user.updateProfile({ displayName: nick }).then(() => { syncUserProfile(cred.user); }))
        .then(() => { registering = false; closeAuthModal(); updateAuthUI(); renderPosts(); })
        .catch(err => {
          registering = false;
          alert((currentLang === "pl" ? "Błąd rejestracji: " : "Registration error: ") + err.message);
        });
    }

    async function uploadImage(file) {
      if (!file) return null;
      const formData = new FormData();
      formData.append("image", file);

      const response = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, {
        method: "POST",
        body: formData
      });

      const data = await response.json();
      if (data.success) {
        return data.data.url;
      } else {
        throw new Error("Błąd podczas przesyłania zdjęcia.");
      }
    }

    function updateFileName(input, targetId) {
      const target = document.getElementById(targetId);
      if (target && input.files && input.files[0]) {
        target.innerText = " " + input.files[0].name;
      }
    }

    function previewImage(input, previewId, nameId) {
      updateFileName(input, nameId);
      const p = document.getElementById(previewId);
      if (!p) return;
      if (input.files && input.files[0]) {
        p.src = URL.createObjectURL(input.files[0]);
        p.style.display = "block";
      } else {
        p.style.display = "none";
      }
    }

    async function createPost() {
      if (!currentUser) return openAuthModal();

      const textInput = document.getElementById("postInput");
      const fileInput = document.getElementById("postImage");
      const text = textInput.value.trim().slice(0, 3000);
      const file = fileInput.files[0];

      if (!text && !file) return alert(currentLang === "pl" ? "Napisz coś lub dodaj zdjęcie!" : "Write something or attach an image!");

      const btn = document.getElementById("txt-publish-btn");
      btn.innerText = i18n[currentLang].uploading;
      btn.disabled = true;

      try {
        const imageUrl = await uploadImage(file);
        const post = { author: getNick(currentUser), uid: currentUser.uid, text: text, timestamp: nowMs() };
        if (imageUrl) post.imageUrl = imageUrl;
        await db.ref('posts').push(post);

        textInput.value = "";
        fileInput.value = "";
        document.getElementById("postImageName").innerText = "";
      } catch (err) {
        alert("Błąd: " + err.message);
      } finally {
        btn.innerText = i18n[currentLang].publishBtn;
        btn.disabled = false;
      }
    }

    async function addComment(postId) {
      if (!currentUser) return openAuthModal();

      const input = document.getElementById("commentInput_" + postId);
      const fileInput = document.getElementById("commentImg_" + postId);
      const text = input ? input.value.trim().slice(0, 1000) : "";
      const file = fileInput ? fileInput.files[0] : null;

      if (!text && !file) return;

      try {
        const imageUrl = await uploadImage(file);
        const c = { author: getNick(currentUser), uid: currentUser.uid, text: text, timestamp: nowMs() };
        if (imageUrl) c.imageUrl = imageUrl;
        await db.ref('posts/' + postId + '/comments').push(c);

        if (input) input.value = "";
        if (fileInput) fileInput.value = "";
      } catch (err) {
        alert("Błąd: " + err.message);
      }
    }

    function deletePost(postId) {
      if (!currentUser) return;
      const post = postsDataCache[postId];
      if (!post || !(isOwnerUser() || post.uid === currentUser.uid)) {
        alert(currentLang === "pl" ? "Brak uprawnień do usunięcia tego wpisu!" : "Unauthorized!");
        renderPosts();
        return;
      }
      if (confirm(currentLang === "pl" ? 'Czy na pewno chcesz usunąć ten post?' : 'Are you sure you want to delete this post?')) {
        db.ref('posts/' + postId).remove().catch(err => alert("Błąd: " + err.message));
      }
    }

    function deleteComment(postId, commentId) {
      if (!currentUser) return;
      const post = postsDataCache[postId];
      const comment = (post && post.comments) ? post.comments[commentId] : null;
      if (!comment || !(isOwnerUser() || comment.uid === currentUser.uid)) {
        alert(currentLang === "pl" ? "Brak uprawnień do usunięcia tego komentarza!" : "Unauthorized!");
        renderPosts();
        return;
      }
      if (confirm(currentLang === "pl" ? 'Usunąć komentarz?' : 'Delete comment?')) {
        db.ref('posts/' + postId + '/comments/' + commentId).remove().catch(err => alert("Błąd: " + err.message));
      }
    }

    async function translateContent(btn, idx, targetDivId) {
      const text = textRegistry[idx];
      const targetDiv = document.getElementById(targetDivId);
      if (!targetDiv || !text) return;

      if (btn.dataset.translated === "true") {
        targetDiv.style.display = "none";
        btn.dataset.translated = "false";
        btn.innerText = i18n[currentLang].translateBtn;
        return;
      }

      btn.innerText = i18n[currentLang].translating;

      try {
        const res = await fetch("https://api.mymemory.translated.net/get?q=" + encodeURIComponent(text) + "&langpair=Autodetect|" + currentLang);
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          targetDiv.innerText = "🌐 " + data.responseData.translatedText;
          targetDiv.style.display = "block";
          btn.dataset.translated = "true";
          btn.innerText = i18n[currentLang].showOriginalBtn;
        } else {
          btn.innerText = i18n[currentLang].translateBtn;
        }
      } catch (e) {
        btn.innerText = i18n[currentLang].translateBtn;
      }
    }

    function regText(t) { textRegistry.push(t); return textRegistry.length - 1; }

    function renderPosts() {
      const container = document.getElementById("postsContainer");
      if (!container) return;
      textRegistry = [];
      const L = i18n[currentLang];

      const keys = Object.keys(postsDataCache);
      if (keys.length === 0) {
        container.innerHTML = '<p style="text-align:center; color: var(--subtext); font-size:0.85rem;">' + esc(L.noPosts) + '</p>';
        return;
      }

      const postsArray = keys.map(key => Object.assign({ id: key }, postsDataCache[key])).reverse();

      container.innerHTML = postsArray.map(post => {
        const canDeletePost = !!currentUser && (isOwnerUser() || currentUser.uid === post.uid);
        const delBtn = canDeletePost
          ? '<button class="delete-btn-admin" data-id="' + esc(post.id) + '" onclick="deletePost(this.dataset.id)">' + esc(L.deleteBtn) + '</button>'
          : '';
        const img = safeUrl(post.imageUrl) ? '<img src="' + esc(safeUrl(post.imageUrl)) + '" class="post-img" alt="">' : '';
        const transId = "postTrans_" + post.id;
        const postTr = post.text
          ? '<div class="translated-box" id="' + esc(transId) + '"></div>' +
            '<button class="translate-btn" data-target="' + esc(transId) + '" onclick="translateContent(this, ' + regText(post.text) + ', this.dataset.target)">' + esc(L.translateBtn) + '</button>'
          : '';

        let commentsHTML = '';
        if (post.comments) {
          commentsHTML = Object.keys(post.comments).map(cId => {
            const c = post.comments[cId];
            const canDel = !!currentUser && (isOwnerUser() || currentUser.uid === c.uid);
            const delC = canDel
              ? '<button class="delete-btn-admin" data-pid="' + esc(post.id) + '" data-cid="' + esc(cId) + '" onclick="deleteComment(this.dataset.pid, this.dataset.cid)">' + esc(L.deleteBtn) + '</button>'
              : '';
            const cImg = safeUrl(c.imageUrl) ? '<img src="' + esc(safeUrl(c.imageUrl)) + '" class="post-img" alt="">' : '';
            const cTransId = "commTrans_" + post.id + "_" + cId;
            const time = new Date(Number(c.timestamp)).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
            return '<div class="comment-item">' +
              '<div class="comment-header">' +
                '<span class="comment-author">' + esc(c.author) + getBadgeHTML(c.uid) + ' ' + delC + '</span>' +
                '<span class="comment-time">' + esc(time) + '</span>' +
              '</div>' +
              (c.text ? '<div class="comment-text">' + esc(c.text) + '</div>' : '') +
              cImg +
              '<div class="translated-box" id="' + esc(cTransId) + '"></div>' +
              (c.text ? '<button class="translate-btn" data-target="' + esc(cTransId) + '" onclick="translateContent(this, ' + regText(c.text) + ', this.dataset.target)">' + esc(L.translateBtn) + '</button>' : '') +
            '</div>';
          }).join('');
        }

        const commentInputHTML =
          '<div class="comments-section">' + commentsHTML +
            '<div class="comment-input-box">' +
              '<div style="display:flex; gap:6px; width:100%;">' +
                '<input type="text" class="comment-input" id="commentInput_' + esc(post.id) + '" maxlength="1000" placeholder="' + esc(L.writeComment) + '">' +
                '<button class="auth-btn-small" data-id="' + esc(post.id) + '" onclick="addComment(this.dataset.id)">' + esc(L.commentBtn) + '</button>' +
              '</div>' +
              '<label class="file-input-btn" style="align-self: flex-start; font-size: 0.7rem; padding: 4px 8px;">📷 <span>' + esc(L.addImgComm) + '</span>' +
                '<input type="file" id="commentImg_' + esc(post.id) + '" accept="image/*" style="display:none;" data-name="cImgName_' + esc(post.id) + '" onchange="updateFileName(this, this.dataset.name)">' +
              '</label>' +
              '<span id="cImgName_' + esc(post.id) + '" style="font-size: 0.7rem; color: var(--purple-light);"></span>' +
            '</div>' +
          '</div>';

        const d = new Date(Number(post.timestamp));
        return '<div class="post-item">' +
          '<div class="post-header">' +
            '<span class="post-author">' + esc(post.author) + getBadgeHTML(post.uid) + delBtn + '</span>' +
            '<span class="post-time">' + esc(d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})) + '</span>' +
          '</div>' +
          (post.text ? '<div class="post-body">' + esc(post.text) + '</div>' : '') +
          img + postTr + commentInputHTML +
        '</div>';
      }).join('');
    }

    // ===== Tłumaczenie wpisów (MyMemory, limit ~500 znaków na zapytanie) =====
    function chunkText(t, max) {
      max = max || 400;
      const out = []; let rest = t;
      while (rest.length > max) {
        let cut = rest.lastIndexOf(" ", max);
        if (cut < 100) cut = max;
        out.push(rest.slice(0, cut).trim());
        rest = rest.slice(cut);
      }
      out.push(rest.trim());
      return out;
    }
    async function translateText(text, from, to) {
      if (!text || !text.trim()) return "";
      let result = "";
      for (const part of chunkText(text)) {
        const res = await fetch("https://api.mymemory.translated.net/get?q=" + encodeURIComponent(part) + "&langpair=" + from + "|" + to);
        const data = await res.json();
        const t = data && data.responseData && data.responseData.translatedText;
        if (!t || Number(data.responseStatus) !== 200 || /MYMEMORY WARNING/i.test(t)) throw new Error("translate failed");
        result += (result ? " " : "") + t;
      }
      return result;
    }

    // ===== Aktualności i Breaking News =====
    function mediaHTML(e, t) {
      const url = safeUrl(e.imageUrl);
      if (!url) return "";
      return '<div class="news-media"><img src="' + esc(url) + '" alt="">' +
        (t.caption ? '<div class="media-overlay-text">' + esc(t.caption) + '</div>' : '') + '</div>';
    }
    function actionsHTML(kind, id, e) {
      if (!canEditEntry(e)) return "";
      const L = i18n[currentLang];
      return '<div style="display:flex;gap:6px;justify-content:center;">' +
        '<button class="auth-btn-small" data-kind="' + kind + '" data-id="' + esc(id) + '" onclick="openNewsEdit(this.dataset.kind, this.dataset.id)">✏️ ' + esc(L.editBtn) + '</button>' +
        '<button class="delete-btn-admin" style="margin-left:0;padding:6px 10px;" data-kind="' + kind + '" data-id="' + esc(id) + '" onclick="deleteEntry(this.dataset.kind, this.dataset.id)">' + esc(L.deleteBtn) + '</button>' +
      '</div>';
    }
    function renderBreaking() {
      let html = "";
      if (breakingCache) {
        const e = breakingCache, t = getLocalized(e);
        html = '<div class="breaking-news-card">' +
          '<div class="breaking-header"><span>🚨</span><span>' + esc(i18n[currentLang].breakingHeader) + '</span><span>🚨</span></div>' +
          '<h2 class="breaking-title">' + esc(t.title) + '</h2>' +
          mediaHTML(e, t) +
          '<p class="news-description" style="white-space:pre-line;">' + esc(t.desc) + '</p>' +
          '<div style="font-size:0.72rem;color:var(--subtext);">' + esc(e.author) + getBadgeHTML(e.uid) + '</div>' +
          actionsHTML("breaking", "", e) +
        '</div>';
      }
      ["breakingHome", "breakingTab"].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.innerHTML = html;
      });
    }
    function renderNewsFeed() {
      const c = document.getElementById("newsFeed");
      if (!c) return;
      const ids = Object.keys(newsCache).sort((a, b) => (newsCache[b].timestamp || 0) - (newsCache[a].timestamp || 0));
      if (!ids.length) {
        c.innerHTML = '<p style="text-align:center;color:var(--subtext);font-size:0.85rem;">' + esc(i18n[currentLang].noNews) + '</p>';
        return;
      }
      c.innerHTML = ids.map(function(id) {
        const n = newsCache[id], t = getLocalized(n);
        return '<div class="post-item">' +
          '<div class="post-header">' +
            '<span class="post-author">' + esc(n.author) + getBadgeHTML(n.origUid || n.uid) + '</span>' +
            '<span class="post-time">' + esc(new Date(Number(n.timestamp)).toLocaleDateString()) + '</span>' +
          '</div>' +
          '<div style="font-weight:800;font-size:1rem;">' + esc(t.title) + '</div>' +
          mediaHTML(n, t) +
          '<div class="post-body" style="white-space:pre-line;">' + esc(t.desc) + '</div>' +
          actionsHTML("news", id, n) +
        '</div>';
      }).join("");
    }

    // Kopia starego breaking news do aktualności. Uzupełnia brakujące pola,
    // więc działa też dla wpisów dodanych ręcznie lub w starszym formacie.
    function buildArchiveEntry(b) {
      const pick = function(l) {
        const t = b[l] || {};
        const o = (l === "pl" ? b.en : b.pl) || {};
        return {
          title: String(t.title || o.title || "—").slice(0, 150),
          desc: String(t.desc || "").slice(0, 4000),
          caption: String(t.caption || "").slice(0, 150)
        };
      };
      const e = {
        uid: currentUser.uid,
        origUid: String(b.uid || currentUser.uid),
        author: String(b.author || getNick(currentUser)).slice(0, 60),
        timestamp: Number(b.timestamp) || nowMs(),
        origLang: b.origLang === "en" ? "en" : "pl",
        archived: true,
        archivedBy: currentUser.uid,
        pl: pick("pl"),
        en: pick("en")
      };
      if (typeof b.imageUrl === "string" && /^https:\/\/i\.ibb\.co(\.com)?\//.test(b.imageUrl)) e.imageUrl = b.imageUrl;
      if (b.editedAt) e.editedAt = Number(b.editedAt);
      return e;
    }

    async function publishNews() {
      if (!isStaffUser()) return;
      const lang = document.getElementById("newsLang").value;
      const other = lang === "pl" ? "en" : "pl";
      const title = document.getElementById("newsTitleInput").value.trim().slice(0, 150);
      const desc = document.getElementById("newsDescInput").value.trim().slice(0, 4000);
      const caption = document.getElementById("newsCaptionInput").value.trim().slice(0, 150);
      const file = document.getElementById("newsImage").files[0];
      const asBreaking = document.getElementById("newsAsBreaking").checked;
      if (!title) return alert(currentLang === "pl" ? "Wpisz tytuł!" : "Enter a title!");

      const btn = document.getElementById("btnNewsPublish");
      btn.disabled = true; btn.innerText = i18n[currentLang].uploading;
      let trFailed = false;
      const tr = async function(txt, max) {
        if (!txt) return "";
        try { return (await translateText(txt, lang, other)).slice(0, max); }
        catch (e) { trFailed = true; return txt; }
      };

      try {
        const imageUrl = await uploadImage(file);
        const tTitle = await tr(title, 150), tDesc = await tr(desc, 4000), tCap = await tr(caption, 150);

        const entry = {
          uid: currentUser.uid,
          author: getNick(currentUser),
          timestamp: nowMs(),
          origLang: lang
        };
        entry[lang] = { title: title, desc: desc, caption: caption };
        entry[other] = { title: tTitle, desc: tDesc, caption: tCap };
        if (imageUrl) entry.imageUrl = imageUrl;

        if (asBreaking) {
          const updates = {};
          if (breakingCache) {
            updates['newsPosts/' + db.ref('newsPosts').push().key] =
              buildArchiveEntry(breakingCache);
          }
          updates['breakingNews'] = entry;
          await db.ref().update(updates);
        } else {
          await db.ref('newsPosts').push(entry);
        }

        ["newsTitleInput", "newsDescInput", "newsCaptionInput", "newsImage"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("newsImageName").innerText = "";
        document.getElementById("newsImagePreview").style.display = "none";
        document.getElementById("newsAsBreaking").checked = false;
        if (trFailed) alert(currentLang === "pl"
          ? "Opublikowano, ale tłumaczenie się nie udało. Użyj „Edytuj”, żeby wpisać je ręcznie."
          : "Published, but auto-translation failed. Use “Edit” to enter it manually.");
      } catch (err) {
        alert("Błąd: " + err.message);
      } finally {
        btn.disabled = false; btn.innerText = i18n[currentLang].publishBtn;
      }
    }

    function openNewsEdit(kind, id) {
      const e = kind === "breaking" ? breakingCache : newsCache[id];
      if (!e || !canEditEntry(e)) return;
      editTarget = { kind: kind, id: id };
      ["pl", "en"].forEach(function(l) {
        const t = e[l] || {};
        document.getElementById("editTitle_" + l).value = t.title || "";
        document.getElementById("editDesc_" + l).value = t.desc || "";
        document.getElementById("editCap_" + l).value = t.caption || "";
      });
      document.getElementById("editImage").value = "";
      document.getElementById("editImageName").innerText = "";
      document.getElementById("editRemoveImage").checked = false;
      document.getElementById("newsEditModal").style.display = "flex";
    }
    function closeNewsEdit() {
      document.getElementById("newsEditModal").style.display = "none";
      editTarget = null;
    }
    async function saveNewsEdit() {
      if (!editTarget) return;
      const ref = editTarget.kind === "breaking" ? db.ref('breakingNews') : db.ref('newsPosts/' + editTarget.id);
      const upd = { editedAt: nowMs() };
      ["pl", "en"].forEach(function(l) {
        upd[l + "/title"] = document.getElementById("editTitle_" + l).value.trim().slice(0, 150);
        upd[l + "/desc"] = document.getElementById("editDesc_" + l).value.trim().slice(0, 4000);
        upd[l + "/caption"] = document.getElementById("editCap_" + l).value.trim().slice(0, 150);
      });
      if (!upd["pl/title"] || !upd["en/title"]) return alert(currentLang === "pl" ? "Tytuł (PL i EN) jest wymagany!" : "Title (PL and EN) is required!");

      const file = document.getElementById("editImage").files[0];
      const remove = document.getElementById("editRemoveImage").checked;
      const btn = document.getElementById("btnSaveEdit");
      btn.disabled = true;
      try {
        if (file) upd.imageUrl = await uploadImage(file);
        else if (remove) upd.imageUrl = null;
        await ref.update(upd);
        closeNewsEdit();
      } catch (err) {
        alert("Błąd: " + err.message);
      } finally {
        btn.disabled = false;
      }
    }
    function deleteEntry(kind, id) {
      const e = kind === "breaking" ? breakingCache : newsCache[id];
      if (!e || !canEditEntry(e)) return;
      if (!confirm(currentLang === "pl" ? "Usunąć ten wpis?" : "Delete this entry?")) return;
      (kind === "breaking" ? db.ref('breakingNews') : db.ref('newsPosts/' + id)).remove()
        .catch(err => alert("Błąd: " + err.message));
    }

    // ===== Panel ról (Właściciel) =====
    function renderRoleAdmin() {
      const box = document.getElementById("roleAdminList");
      if (!box || !isOwnerUser()) return;
      const uids = Object.keys(usersCache).sort((a, b) => String(usersCache[a].nick).localeCompare(String(usersCache[b].nick)));
      if (!uids.length) {
        box.innerHTML = '<p style="font-size:0.78rem;color:var(--subtext);">' +
          (currentLang === "pl" ? "Brak użytkowników. Pojawią się po zalogowaniu." : "No users yet. They appear after logging in.") + '</p>';
        return;
      }
      box.innerHTML = uids.map(function(uid) {
        const u = usersCache[uid], role = rolesCache[uid] || "";
        const control = role === "owner" ? getOwnerBadgeHTML() :
          '<select class="auth-input" style="width:auto;margin:0;padding:4px 6px;" data-uid="' + esc(uid) + '" onchange="setRole(this.dataset.uid, this.value)">' +
          ["", "chad", "mod"].map(function(r) {
            return '<option value="' + r + '"' + (r === role ? ' selected' : '') + '>' + (r === "" ? "—" : r.toUpperCase()) + '</option>';
          }).join("") + '</select>';
        return '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.06);font-size:0.78rem;">' +
          '<div style="min-width:0;overflow:hidden;text-overflow:ellipsis;"><b>' + esc(u.nick) + '</b>' + getBadgeHTML(uid) +
          '<div style="color:var(--subtext);font-size:0.7rem;">' + esc(u.email) + '</div></div>' + control + '</div>';
      }).join("");
    }
    function setRole(uid, role) {
      if (!isOwnerUser()) return;
      const ref = db.ref('roles/' + uid);
      (role ? ref.set(role) : ref.remove()).catch(err => alert("Błąd: " + err.message));
    }

    db.ref('roles').on('value', function(s) {
      rolesCache = s.val() || {};
      updateAuthUI();
      renderPosts();
      renderRoleAdmin();
    });
    db.ref('newsPosts').on('value', function(s) { newsCache = s.val() || {}; renderNewsFeed(); });
    db.ref('breakingNews').on('value', function(s) { breakingCache = s.val(); renderBreaking(); });

    db.ref('posts').on('value', (snapshot) => {
      postsDataCache = snapshot.val() || {};
      renderPosts();
    });

            // Główny bezpieczny słuchacz głosów w Firebase
  // 1. Niezależne nasłuchiwanie głosów
    db.ref('votes').on('value', function(snapshot) {
      const votes = snapshot.val() || {};

      chadsData.forEach(chad => {
        const rawVote = votes[chad.id];
        let voteCount = 0;
        if (typeof rawVote === 'number') {
          voteCount = rawVote;
        } else if (typeof rawVote === 'object' && rawVote !== null) {
          voteCount = Number(rawVote.votes) || 0;
        } else if (rawVote !== undefined && rawVote !== null) {
          voteCount = Number(rawVote) || 0;
        }
        chad.votes = voteCount;
      });

      currentVotesCache = {};
      chadsData.forEach(chad => {
        currentVotesCache[chad.id] = chad.votes;
      });

      updatePollVotesCount();
      updatePollUI();

      if (typeof activeChadId !== 'undefined' && activeChadId) {
        const activeChad = chadsData.find(c => c.id === activeChadId);
        if (activeChad) {
          const votesElem = document.getElementById("modalStatVotes");
          if (votesElem) votesElem.innerText = activeChad.votes;
        }
      }
    }, function(error) {
      console.error("Błąd odczytu głosów z Firebase:", error);
    });

    // 2. Niezależne nasłuchiwanie rang (pozycji) z Firebase po resecie
    db.ref('rankings').on('value', function(snapshot) {
      const savedRankings = snapshot.val() || {};
      
      chadsData.forEach(chad => {
        if (savedRankings[chad.id] !== undefined) {
          chad.rank = Number(savedRankings[chad.id]);
        }
      });

      renderRankings();
    }, function(error) {
      console.error("Błąd odczytu rang z Firebase:", error);
    });

    // 3. Nasłuchiwanie odblokowania pozycji 16-20 po resecie
    db.ref('revealed16to20').on('value', function(snapshot) {
      if (snapshot.val() === true) {
        const idsToReveal = ["chad_16", "chad_17", "chad_18", "chad_19", "chad_20"];
        chadsData.forEach(chad => {
          if (idsToReveal.includes(chad.id)) {
            chad.locked = false;
          }
        });
        renderRankings();
      }
    });
    
    
    
    

    // Funkcja sortująca osoby wg głosów, ustalająca nowe miejsca (1-15) i zerująca głosy
        async function performWeeklyReset(newWeekKey) {
      if (!isOwnerUser()) return;
      const idsToReveal = ["chad_16", "chad_17", "chad_18", "chad_19", "chad_20"];
      const wasLocked = {}, oldRanks = {};
      chadsData.forEach(c => { wasLocked[c.id] = !!c.locked; oldRanks[c.id] = c.rank; });

      let votesNow = {}, duel = {}, auraNow = {}, weekId = null;
      try {
        const snaps = await Promise.all([
          db.ref('votes').once('value'), db.ref('duelStats').once('value'),
          db.ref('aura').once('value'), db.ref('weekId').once('value')
        ]);
        votesNow = snaps[0].val() || {};
        duel = snaps[1].val() || {};
        auraNow = snaps[2].val() || {};
        weekId = snaps[3].val();
      } catch (err) {
        alert("Błąd odczytu z Firebase: " + err.message);
        return;
      }

      const voteOf = id => {
        const v = votesNow[id];
        return typeof v === 'number' ? v : (Number(v && v.votes) || 0);
      };
      const activeChads = chadsData.filter(c => c.name && c.name.trim() !== "");
      activeChads.sort((a, b) => (voteOf(b.id) - voteOf(a.id)) || (oldRanks[a.id] - oldRanks[b.id]));

      const newRankings = {}, prevRankings = {}, deltas = {}, newAura = {}, votesMap = {};
      activeChads.forEach((c, i) => {
        const newRank = i + 1;
        newRankings[c.id] = newRank;
        const locked = wasLocked[c.id];
        const wl = duel[c.id] || {};
        const duelNet = (Number(wl.w) || 0) - (Number(wl.l) || 0);
        const duelAura = Math.max(-DUEL_AURA_CAP, Math.min(DUEL_AURA_CAP, round1(duelNet * DUEL_AURA_STEP)));
        const moves = locked ? 0 : (oldRanks[c.id] - newRank);
        const delta = locked ? 0 : round1(moves * AURA_PER_RANK + duelAura);
        const base = typeof auraNow[c.id] === 'number' ? auraNow[c.id] : AURA_START;
        newAura[c.id] = Math.max(0, round1(base + delta));
        deltas[c.id] = delta;
        if (!locked) prevRankings[c.id] = oldRanks[c.id];
        const v = voteOf(c.id);
        if (v > 0) votesMap[c.id] = v;
      });

      const topId = activeChads.length ? activeChads[0].id : null;
      const n = (weekNum(weekId || 'w0') || 0) + 1;
      const newWeekId = 'w' + n;
      const d = new Date();
      const month = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      const hist = { n: n, ts: SV_TS, month: month, ranks: newRankings, deltas: deltas };
      if (topId && voteOf(topId) > 0) { hist.winner = topId; hist.winnerVotes = voteOf(topId); }
      if (Object.keys(votesMap).length) hist.votes = votesMap;

      const upd = {
        rankings: newRankings,
        prevRankings: prevRankings,
        aura: newAura,
        weekId: newWeekId,
        currentWeek: newWeekKey,
        resetVersion: Date.now(),
        revealed16to20: true,
        votes: null,
        duelStats: null
      };
      upd['history/' + newWeekId] = hist;

      try {
        await db.ref().update(upd);
        chadsData.forEach(c => { if (idsToReveal.includes(c.id)) c.locked = false; });
        activeChads.forEach(c => { c.rank = newRankings[c.id]; c.votes = 0; });
        alert(currentLang === "pl" ? "Ranking został pomyślnie zresetowany na stałe!" : "Ranking reset saved permanently!");
        renderRankings();
      } catch (err) {
        console.error("Błąd zapisu do Firebase:", err);
        alert("Błąd zapisu do Firebase: " + err.message + "\nSprawdź reguły (Rules) w konsoli Firebase!");
      }
    }

    function triggerOwnerReset() {
  if (!currentUser || currentUser.email !== ADMIN_EMAIL) {
    alert("Brak uprawnień!");
    return;
  }

  const isConfirmed = confirm("Czy na pewno chcesz odblokować pozycje 16-20, posortować ranking od największej liczby głosów i wyzerować głosy w bazie?");
  if (isConfirmed) {
    const thisWeek = getWeekIdentifier();
    performWeeklyReset(thisWeek);
  }
    }
    
    
    function setLanguage(lang) {
      currentLang = lang;
      document.getElementById("flag-pl").classList.toggle("active", lang === "pl");
      document.getElementById("flag-en").classList.toggle("active", lang === "en");

      document.getElementById("txt-hero").innerText = i18n[lang].hero;
      document.getElementById("txt-verified").innerText = i18n[lang].verified;
      document.getElementById("st-rank").innerText = i18n[lang].stRank;
      document.getElementById("st-votes").innerText = i18n[lang].stVotes;
      document.getElementById("txt-poll-title").innerText = i18n[lang].pollTitle;
      document.getElementById("txt-hof-title").innerText = i18n[lang].hofTitle;
      document.getElementById("txt-hof-sub").innerText = i18n[lang].hofSub;
      document.getElementById("txt-poll-badge").innerText = i18n[lang].pollBadge;
      document.getElementById("txt-tab-rankings").innerText = i18n[lang].tabRankings;
      document.getElementById("txt-tab-news").innerText = i18n[lang].tabNews;
      document.getElementById("txt-tab-community").innerText = i18n[lang].tabCommunity;
      document.getElementById("postInput").placeholder = i18n[lang].writePost;
      document.getElementById("txt-publish-btn").innerText = i18n[lang].publishBtn;
      document.getElementById("txt-lock-overlay").innerText = i18n[lang].lockOverlayText;
      document.getElementById("txt-add-img").innerText = i18n[lang].addImage;

      document.getElementById("txt-news-page-title").innerText = i18n[lang].newsPageTitle;
      document.getElementById("txt-trending-news-title").innerText = i18n[lang].trendingNewsTitle;

      document.querySelectorAll(".txt-breaking-header").forEach(el => el.innerText = i18n[lang].breakingHeader);
      document.querySelectorAll(".txt-breaking-title").forEach(el => el.innerText = i18n[lang].breakingTitle);
      document.querySelectorAll(".txt-media-overlay").forEach(el => el.innerText = i18n[lang].mediaOverlay);
      document.querySelectorAll(".txt-news-desc").forEach(el => el.innerText = i18n[lang].newsDesc);

      document.getElementById("txt-auth-title").innerText = i18n[lang].authTitle;
      document.getElementById("authUsername").placeholder = i18n[lang].usernamePlaceholder;
      document.getElementById("authEmail").placeholder = i18n[lang].emailPlaceholder;
      document.getElementById("authPassword").placeholder = i18n[lang].passwordPlaceholder;
      document.getElementById("txt-login-btn").innerText = i18n[lang].modalLoginBtn;
      document.getElementById("txt-register-btn").innerText = i18n[lang].modalRegisterBtn;

      setupPollUI();
      renderRankings();
      renderHallOfFame();
      updateAuthUI();
      renderPosts();
      renderExtras();

      if (activeChadId !== null) {
        const chad = chadsData.find(c => c.id === activeChadId);
        if (chad) {
          updateModalText(chad);
          updateVoteButtonState(chad.id);
        }
      }
    }

    function openModal(chad) {
      activeChadId = chad.id;
      const isLocked = chad.locked;
      const avatarContainer = document.getElementById("modalAvatarContainer");

      avatarContainer.innerHTML = (!isLocked && chad.img) 
        ? '<img src="' + chad.img + '" class="modal-avatar" alt="Chad">'
        : '<div class="modal-avatar">❓</div>';

      document.getElementById("modalStatRank").innerText = "#" + chad.rank;
      document.getElementById("modalStatAura").innerText = isLocked ? "???" : getAura(chad).toFixed(1);
      document.getElementById("modalStatVotes").innerText = chad.votes;

      updateModalText(chad);
      updateVoteButtonState(chad.id);
      document.getElementById("profileModal").style.display = "flex";
      refreshPower();
      refreshModalDuel();
    }

    function updateModalText(chad) {
      const isLocked = chad.locked;
      document.getElementById("modalName").innerText = isLocked ? i18n[currentLang].unrevealedName : chad.name;
      document.getElementById("modalTitle").innerText = isLocked 
        ? i18n[currentLang].unrevealedTitle 
        : (currentLang === "pl" ? chad.titlePl : chad.titleEn);
      document.getElementById("modalDesc").innerText = isLocked 
        ? i18n[currentLang].unrevealedDesc 
        : (currentLang === "pl" ? chad.descPl : chad.descEn);
    }

    async function ensureVoter() {
      if (auth.currentUser) return auth.currentUser;
      try { const c = await auth.signInAnonymously(); return c.user; } catch (e) { return null; }
    }

    async function getLastVoteTime(chadId) {
      const u = await ensureVoter();
      if (!u) return null;
      try {
        const snap = await db.ref('voteLog/' + u.uid + '/' + chadId).once('value');
        return snap.val() || 0;
      } catch (e) { return null; }
    }

    async function updateVoteButtonState(id) {
      const btn = document.getElementById("btnVote");
      const chad = chadsData.find(c => c.id === id);

      if (!chad || chad.locked) {
        btn.style.display = "none";
        return;
      }

      btn.style.display = "inline-flex";
      if (modalTimerInterval) clearInterval(modalTimerInterval);

      const last = await getLastVoteTime(id);
      if (activeChadId !== id) return;
      applyTimerToButton(last || 0);
    }

    function applyTimerToButton(lastVoteTime) {
      const btn = document.getElementById("btnVote");
      if (modalTimerInterval) clearInterval(modalTimerInterval);

      const checkState = () => {
        const timeLeft = VOTE_COOLDOWN - (nowMs() - lastVoteTime);

        if (timeLeft > 0) {
          btn.disabled = true;
          btn.classList.add("voted");
          const m = Math.floor(timeLeft / 60000);
          const s = Math.floor((timeLeft % 60000) / 1000);
          const waitPrefix = (i18n[currentLang] && i18n[currentLang].voteWait) || "⏳ Odczekaj";
          document.getElementById("txt-vote").innerText = waitPrefix + " " + m + "m " + s + "s";
        } else {
          btn.disabled = false;
          btn.classList.remove("voted");
          document.getElementById("txt-vote").innerText = i18n[currentLang].btnVote;
          if (modalTimerInterval) clearInterval(modalTimerInterval);
        }
      };

      checkState();
      modalTimerInterval = setInterval(checkState, 1000);
    }

    // Głos + zapis czasu w jednej atomowej operacji. Cooldown egzekwują reguły bazy (voteLog),
    // więc obejście przycisku w konsoli nic nie daje.
    async function castVote() {
      if (!activeChadId) return;
      const chadId = activeChadId;
      const chad = chadsData.find(c => c.id === chadId);
      if (!chad || chad.locked) return;

      const btn = document.getElementById("btnVote");
      if (btn) btn.disabled = true;

      try {
        const user = await ensureVoter();
        if (!user) {
          alert(currentLang === "pl" ? "Nie udało się zweryfikować przeglądarki. Odśwież stronę." : "Could not verify your browser. Reload the page.");
          return;
        }

        const last = await getLastVoteTime(chadId);
        if (last && nowMs() - last < VOTE_COOLDOWN) return;

        let ok = false;
        for (let i = 0; i < 5 && !ok; i++) {
          const snap = await db.ref('votes/' + chadId).once('value');
          const cur = Number(snap.val()) || 0;
          const upd = {};
          upd['voteLog/' + user.uid + '/' + chadId] = firebase.database.ServerValue.TIMESTAMP;
          upd['votes/' + chadId] = cur + 1;
          if (i < 2) streakEntryFor(upd, user.uid, chadId);
          try {
            await db.ref().update(upd);
            ok = true;
          } catch (e) {
            await new Promise(r => setTimeout(r, 150 + Math.random() * 350));
          }
        }
        if (!ok) alert(currentLang === "pl" ? "Nie udało się oddać głosu. Spróbuj ponownie." : "Could not cast the vote. Try again.");
      } finally {
        updateVoteButtonState(chadId);
      }
    }

    function closeModal() {
  if (powerTimer) { clearInterval(powerTimer); powerTimer = null; }
  document.getElementById("profileModal").style.display = "none";
  activeChadId = null;
  if (modalTimerInterval) clearInterval(modalTimerInterval);
    }
    
        function updateCountdown() {
      const timerElem = document.getElementById("timer-text");
      if (!timerElem) return;

      const now = new Date();
      const nextUpdate = new Date();
      const daysUntilSunday = (7 - now.getDay()) % 7;
      nextUpdate.setDate(now.getDate() + daysUntilSunday);
      nextUpdate.setHours(23, 59, 59, 999);

      let diff = nextUpdate - now;

      // Jeśli licznik właśnie wyzerował się na żywo na ekranie użytkownika:
      if (diff <= 0) {
        const thisWeek = getWeekIdentifier();
        if (isOwnerUser()) performWeeklyReset(thisWeek);
        diff = 0;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      timerElem.innerText = i18n[currentLang].timerPrefix + days + "d " + hours + "h " + minutes + "m " + seconds + "s";
        }
    
// =====================================================================
    // ROZSZERZENIA: trendy, aura, farmerzy, Matchup, Super/Mega-Głos, serie, archiwum, karta TOP 3
    // =====================================================================
    var AURA_START = 50, AURA_PER_RANK = 2, DUEL_AURA_STEP = 0.1, DUEL_AURA_CAP = 5, SUPER_COOLDOWN = 86400000;
    var SV_TS = firebase.database.ServerValue.TIMESTAMP;
    var auraCache = {}, prevRankCache = {}, historyCache = {}, weekIdCache = null, duelStatsCache = {};
    var myWeeksCache = {}, mySuper = null, myMega = null, extrasUid = null, extrasRefs = [];
    var powerTimer = null, duelPair = null, duelBusy = false, lastDuelAt = 0, rankMode = 'list';
    var shareBlob = null, shareUrl = null;

    function noop() {}
    function sleep(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }
    function L2(pl, en) { return currentLang === 'pl' ? pl : en; }
    function round1(x) { return Math.round(x * 10) / 10; }
    function weekNum(k) { const n = parseInt(String(k).replace(/^w/, ''), 10); return isNaN(n) ? null : n; }
    function listen(path, fn) {
      db.ref(path).on('value', fn, function(err) { console.warn('Firebase read failed: ' + path, err && err.message); });
    }

    // ---- Aura i trendy ----
    function getAura(chad) { const v = auraCache[chad.id]; return typeof v === 'number' ? v : AURA_START; }
    function getAuraText(chad) { return chad.locked ? "🔒" : getAura(chad).toFixed(1); }
    function trendHTML(chad) {
      if (chad.locked) return "";
      const p = prevRankCache[chad.id];
      if (typeof p !== 'number') return "";
      const d = p - chad.rank;
      if (d > 0) return '<span class="trend up">▲' + d + '</span>';
      if (d < 0) return '<span class="trend down">▼' + (-d) + '</span>';
      return '<span class="trend same">–</span>';
    }
    function refreshModalAura() {
      if (!activeChadId) return;
      const c = chadsData.find(x => x.id === activeChadId);
      const el = document.getElementById("modalStatAura");
      if (c && el) el.innerText = c.locked ? "???" : getAura(c).toFixed(1);
    }

    // ---- Historia: farmerzy i archiwum ----
    function histArr() {
      return Object.keys(historyCache).map(function(k) { return Object.assign({ key: k }, historyCache[k]); })
        .filter(function(h) { return h && typeof h === 'object'; })
        .sort(function(a, b) { return (Number(b.n) || 0) - (Number(a.n) || 0); });
    }
    function bestOf(map, positiveOnly) {
      let bid = null, bv = -Infinity;
      Object.keys(map || {}).forEach(function(id) {
        const v = Number(map[id]);
        if (v > bv && chadsData.some(function(c) { return c.id === id; })) { bv = v; bid = id; }
      });
      if (bid === null || (positiveOnly && bv <= 0)) return null;
      return { id: bid, v: bv };
    }
    function sumMaps(list, field) {
      const out = {};
      list.forEach(function(h) {
        const m = h[field] || {};
        Object.keys(m).forEach(function(id) { out[id] = (out[id] || 0) + (Number(m[id]) || 0); });
      });
      return out;
    }
    function monthKeyNow() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'); }
    function monthLabel(key) {
      const p = String(key).split('-');
      const d = new Date(Number(p[0]), Number(p[1]) - 1, 1);
      return d.toLocaleDateString(currentLang === 'pl' ? 'pl-PL' : 'en-US', { month: 'long', year: 'numeric' });
    }
    function chadAvatarHTML(c, cls) {
      return (c && c.img) ? '<img class="' + cls + '" src="' + esc(c.img) + '" alt="">'
                          : '<div class="' + cls + ' arch-ph">🗿</div>';
    }
    function farmItemHTML(label, best) {
      if (!best) return '<div class="farm-item"><div class="farm-label">' + esc(label) + '</div><div class="farm-val" style="color:var(--subtext)">—</div></div>';
      const c = chadsData.find(function(x) { return x.id === best.id; });
      return '<div class="farm-item"><div class="farm-label">' + esc(label) + '</div>' +
        chadAvatarHTML(c, 'farm-avatar') +
        '<div class="farm-name">' + esc(c ? c.name : best.id) + '</div>' +
        '<div class="farm-val">+' + round1(best.v).toFixed(1) + ' aura</div></div>';
    }
    function renderFarmers() {
      const box = document.getElementById('farmBox');
      if (!box) return;
      const arr = histArr();
      if (!arr.length) { box.style.display = 'none'; return; }
      const week = bestOf(arr[0].deltas, true);
      const cur = monthKeyNow();
      let list = arr.filter(function(h) { return h.month === cur; });
      if (!list.length) list = arr.filter(function(h) { return h.month === arr[0].month; });
      const month = bestOf(sumMaps(list, 'deltas'), true);
      box.style.display = 'flex';
      box.innerHTML = farmItemHTML('🌾 ' + L2('Aura Farmer tygodnia', 'Aura Farmer of the week'), week) +
                      farmItemHTML('🌾 ' + L2('Aura Farmer miesiąca', 'Aura Farmer of the month'), month);
    }
    function archRowHTML(label, best, suffix, plus) {
      const c = best ? chadsData.find(function(x) { return x.id === best.id; }) : null;
      return '<div class="arch-row">' + chadAvatarHTML(c, 'arch-avatar') +
        '<div><div class="arch-label">' + esc(label) + '</div>' +
        '<div class="arch-name">' + esc(best ? (c ? c.name : best.id) : '—') + '</div>' +
        (best ? '<div class="arch-val">' + (plus ? '+' : '') + (plus ? round1(best.v).toFixed(1) : best.v) + esc(suffix) + '</div>' : '') +
        '</div></div>';
    }
    function renderArchive() {
      const box = document.getElementById('archiveContent');
      if (!box) return;
      const t = document.getElementById('archTitle');
      if (t) t.innerText = '🏆 ' + L2('ARCHIWUM', 'ARCHIVE');
      const arr = histArr();
      if (!arr.length) {
        box.innerHTML = '<p style="text-align:center;color:var(--subtext);font-size:0.85rem;">' +
          esc(L2('Archiwum jest puste. Pierwsze wpisy pojawią się po najbliższym resecie rankingu.',
                 'The archive is empty. The first entries will appear after the next ranking reset.')) + '</p>';
        return;
      }
      const months = [];
      arr.forEach(function(h) { if (h.month && months.indexOf(h.month) < 0) months.push(h.month); });
      let html = '<div class="section-title-news">📅 ' + esc(L2('Podsumowania miesięcy', 'Monthly recaps')) + '</div>';
      months.forEach(function(m) {
        const list = arr.filter(function(h) { return h.month === m; });
        html += '<div class="arch-month"><div class="arch-month-title">' + esc(monthLabel(m)) + '</div>' +
          archRowHTML('👑 ' + L2('Najpopularniejszy Chad miesiąca', 'Most popular Chad of the month'), bestOf(sumMaps(list, 'votes'), true), ' ' + L2('głosów', 'votes'), false) +
          archRowHTML('🌾 ' + L2('Aura Farmer miesiąca', 'Aura Farmer of the month'), bestOf(sumMaps(list, 'deltas'), true), ' aura', true) +
          '</div>';
      });
      html += '<div class="section-title-news" style="margin-top:6px;">🏆 ' + esc(L2('Zwycięzcy tygodni', 'Weekly winners')) + '</div>';
      arr.forEach(function(h) {
        if (!h.winner) return;
        const c = chadsData.find(function(x) { return x.id === h.winner; });
        const date = h.ts ? new Date(Number(h.ts)).toLocaleDateString() : '';
        html += '<div class="arch-week"><div class="arch-row">' + chadAvatarHTML(c, 'arch-avatar') +
          '<div><div class="arch-label">' + esc(L2('Zwycięzca Tygodnia #', 'Winner of Week #') + (h.n || '?')) + (date ? ' · ' + esc(date) : '') + '</div>' +
          '<div class="arch-name">' + esc(c ? c.name : h.winner) + '</div>' +
          '<div class="arch-val">' + esc(String(h.winnerVotes || 0)) + ' ' + esc(L2('głosów', 'votes')) + '</div></div></div></div>';
      });
      box.innerHTML = html;
    }

    // ---- Serie głosowań i odznaki ----
    function getStreak() {
      if (!extrasUid) return 0;
      const have = {};
      Object.keys(myWeeksCache).forEach(function(k) { const n = weekNum(k); if (n !== null) have[n] = true; });
      const cur = weekNum(weekIdCache || 'w0') || 0;
      let n = have[cur] ? cur : cur - 1, s = 0;
      while (have[n]) { s++; n--; }
      return s;
    }
    function streakTier(s) {
      if (s >= 8) return { pl: 'Legenda', en: 'Legend', icon: '👑' };
      if (s >= 4) return { pl: 'Weteran', en: 'Veteran', icon: '🎖️' };
      if (s >= 2) return { pl: 'Stały Głosujący', en: 'Regular Voter', icon: '🔥' };
      return null;
    }
    function streakBadgeHTML() {
      const t = streakTier(getStreak());
      return t ? '<span class="streak-badge">' + t.icon + ' ' + esc(L2(t.pl, t.en)) + '</span>' : '';
    }
    function renderStreak() {
      const el = document.getElementById('streakBox');
      if (!el) return;
      if (!extrasUid) { el.style.display = 'none'; return; }
      const s = getStreak(), t = streakTier(s);
      const next = s < 2 ? 2 : s < 4 ? 4 : s < 8 ? 8 : null;
      el.style.display = 'flex';
      el.innerHTML = '<div><b>🔥 ' + esc(L2('Twoja seria głosowań: ', 'Your voting streak: ')) + s + ' ' + esc(L2('tyg.', 'wk')) + '</b>' +
        '<div class="subtext-s">' + esc(next ? L2('Jeszcze ' + (next - s) + ' tyg. do kolejnej odznaki.', (next - s) + ' more week(s) to the next badge.')
                                              : L2('Masz najwyższą odznakę!', 'You have the top badge!')) + '</div></div>' +
        (t ? '<span class="streak-badge">' + t.icon + ' ' + esc(L2(t.pl, t.en)) + '</span>' : '');
    }
    function streakEntryFor(upd, uid, chadId) {
      if (!extrasUid || uid !== extrasUid) return;
      const W = weekIdCache || 'w0';
      if (myWeeksCache[W]) return;
      upd['userWeeks/' + uid + '/' + W] = chadId;
    }

    // ---- Super-Głos i Mega-Głos ----
    function fmtLeft(ms) {
      const h = Math.floor(ms / 3600000), m = Math.floor((ms % 3600000) / 60000), s = Math.floor((ms % 60000) / 1000);
      return h + 'h ' + m + 'm ' + s + 's';
    }
    function refreshPower() {
      if (powerTimer) { clearInterval(powerTimer); powerTimer = null; }
      const box = document.getElementById('powerBox');
      if (!box) return;
      const chad = activeChadId ? chadsData.find(function(c) { return c.id === activeChadId; }) : null;
      if (!chad || chad.locked) { box.style.display = 'none'; return; }
      box.style.display = 'flex';
      const draw = function() {
        const sBtn = document.getElementById('btnSuper'), mBtn = document.getElementById('btnMega'), hint = document.getElementById('powerHint');
        if (!sBtn || !mBtn || !hint) return;
        if (!extrasUid) {
          sBtn.style.display = 'none'; mBtn.style.display = 'none'; hint.style.display = 'block';
          hint.innerText = L2('Zaloguj się, aby używać Super-Głosu (+2) i Mega-Głosu (+5).', 'Log in to use the Super Vote (+2) and Mega Vote (+5).');
          return;
        }
        hint.style.display = 'none'; sBtn.style.display = 'inline-flex'; mBtn.style.display = 'inline-flex';
        const left = mySuper ? SUPER_COOLDOWN - (nowMs() - Number(mySuper.t)) : 0;
        if (left > 0) {
          sBtn.disabled = true; sBtn.classList.add('voted');
          sBtn.innerText = '⚡ ' + L2('Super-Głos za ', 'Super Vote in ') + fmtLeft(left);
        } else {
          sBtn.disabled = false; sBtn.classList.remove('voted');
          sBtn.innerText = '⚡ ' + L2('Super-Głos (+2)', 'Super Vote (+2)');
        }
        const W = weekIdCache || 'w0';
        if (myMega && myMega.w === W) {
          const tc = chadsData.find(function(c) { return c.id === myMega.c; });
          mBtn.disabled = true; mBtn.classList.add('voted');
          mBtn.innerText = '💎 ' + L2('Mega-Głos wykorzystany', 'Mega Vote used') + (tc ? ' → ' + tc.name : '');
        } else {
          mBtn.disabled = false; mBtn.classList.remove('voted');
          mBtn.innerText = '💎 ' + L2('Mega-Głos (+5)', 'Mega Vote (+5)');
        }
      };
      draw();
      powerTimer = setInterval(draw, 1000);
    }
    async function castPower(kind) {
      if (!currentUser || !extrasUid) return openAuthModal();
      if (!activeChadId) return;
      const chadId = activeChadId;
      const chad = chadsData.find(function(c) { return c.id === chadId; });
      if (!chad || chad.locked) return;
      const isMega = kind === 'mega';
      const W = weekIdCache || 'w0';
      if (!isMega && mySuper && nowMs() - Number(mySuper.t) < SUPER_COOLDOWN) return;
      if (isMega && myMega && myMega.w === W) return;
      if (isMega && !confirm(L2('Mega-Głos (+5) możesz użyć tylko raz w tygodniu i tylko na jedną osobę. Oddać go na: ' + chad.name + '?',
                                 'You can use the Mega Vote (+5) only once a week, on one person. Cast it for ' + chad.name + '?'))) return;
      const sBtn = document.getElementById('btnSuper'), mBtn = document.getElementById('btnMega');
      sBtn.disabled = true; mBtn.disabled = true;
      const uid = extrasUid;
      let ok = false;
      for (let i = 0; i < 5 && !ok; i++) {
        try {
          const snap = await db.ref('votes/' + chadId).once('value');
          const cur = Number(snap.val()) || 0;
          const upd = {};
          upd['votes/' + chadId] = cur + (isMega ? 5 : 2);
          upd[(isMega ? 'megaLog/' : 'superLog/') + uid] = isMega ? { c: chadId, w: W, t: SV_TS } : { c: chadId, t: SV_TS };
          if (i < 2) streakEntryFor(upd, uid, chadId);
          await db.ref().update(upd);
          ok = true;
        } catch (e) {
          await sleep(150 + Math.random() * 350);
        }
      }
      if (!ok) alert(L2('Nie udało się oddać głosu. Spróbuj ponownie.', 'Could not cast the vote. Try again.'));
      refreshPower();
    }

    // ---- Matchup (pojedynki 1v1) ----
    function duelPool() { return chadsData.filter(function(c) { return !c.locked && c.name && c.name.trim(); }); }
    function newDuel() {
      const pool = duelPool();
      if (pool.length < 2) { duelPair = null; return; }
      const prev = duelPair ? duelPair.map(function(c) { return c.id; }).sort().join('|') : '';
      let a, b, guard = 0;
      do {
        a = pool[Math.floor(Math.random() * pool.length)];
        b = pool[Math.floor(Math.random() * pool.length)];
        guard++;
      } while ((a.id === b.id || [a.id, b.id].sort().join('|') === prev) && guard < 40);
      if (a.id === b.id) { duelPair = null; return; }
      duelPair = [a, b];
    }
    function duelCardHTML(c) {
      const sub = currentLang === 'pl' ? c.titlePl : c.titleEn;
      return (c.img ? '<img src="' + esc(c.img) + '" class="duel-img" alt="">' : '<div class="duel-img duel-ph">❓</div>') +
        '<div class="duel-name">' + esc(c.name) + '</div><div class="duel-sub">' + esc(sub) + '</div>';
    }
    function renderDuel(feedback) {
      const box = document.getElementById('duelBox');
      if (!box || rankMode !== 'duel') return;
      if (!duelPair) newDuel();
      document.getElementById('duelTitle').innerText = L2('Kto jest lepszy? Kliknij, żeby wybrać.', 'Who is better? Tap to choose.');
      if (duelPair) {
        document.getElementById('duelA').innerHTML = duelCardHTML(duelPair[0]);
        document.getElementById('duelB').innerHTML = duelCardHTML(duelPair[1]);
      } else {
        document.getElementById('duelA').innerHTML = '';
        document.getElementById('duelB').innerHTML = '';
      }
      document.getElementById('duelFeedback').innerText = feedback || '';
    }
    async function pickDuel(i) {
      if (duelBusy || !duelPair) return;
      if (Date.now() - lastDuelAt < 3200) {
        document.getElementById('duelFeedback').innerText = L2('Chwila… za szybko!', 'Slow down a little…');
        return;
      }
      duelBusy = true;
      const w = duelPair[i], l = duelPair[1 - i];
      let msg = '';
      try {
        const user = await ensureVoter();
        if (!user) throw new Error('auth');
        let ok = false, wins = 0;
        for (let k = 0; k < 4 && !ok; k++) {
          try {
            const res = await Promise.all([db.ref('duelStats/' + w.id + '/w').once('value'), db.ref('duelStats/' + l.id + '/l').once('value')]);
            wins = (Number(res[0].val()) || 0) + 1;
            const upd = {};
            upd['duelLog/' + user.uid] = { w: w.id, l: l.id, t: SV_TS };
            upd['duelStats/' + w.id + '/w'] = wins;
            upd['duelStats/' + l.id + '/l'] = (Number(res[1].val()) || 0) + 1;
            await db.ref().update(upd);
            ok = true;
          } catch (e) {
            await sleep(200 + Math.random() * 400);
          }
        }
        lastDuelAt = Date.now();
        const losses = Number((duelStatsCache[w.id] || {}).l) || 0;
        msg = ok ? '✅ ' + w.name + L2(' wygrywa! Bilans: ', ' wins! Record: ') + wins + 'W / ' + losses + 'L'
                 : L2('Nie udało się zapisać wyboru. Spróbuj za chwilę.', 'Could not save your pick. Try again shortly.');
      } catch (e) {
        msg = L2('Błąd połączenia. Odśwież stronę.', 'Connection error. Reload the page.');
      } finally {
        duelBusy = false;
      }
      newDuel();
      renderDuel(msg);
    }
    function refreshModalDuel() {
      const el = document.getElementById('modalDuel');
      if (!el) return;
      if (!activeChadId) { el.innerText = ''; return; }
      const st = duelStatsCache[activeChadId] || {};
      const w = Number(st.w) || 0, l = Number(st.l) || 0;
      el.innerText = (w || l) ? '⚔️ ' + L2('Pojedynki w tym tygodniu: ', 'Duels this week: ') + w + 'W / ' + l + 'L' : '';
    }
    function setRankMode(m) {
      rankMode = m;
      document.getElementById('modeList').classList.toggle('active', m === 'list');
      document.getElementById('modeDuel').classList.toggle('active', m === 'duel');
      document.getElementById('rankings').style.display = m === 'list' ? '' : 'none';
      document.getElementById('duelBox').style.display = m === 'duel' ? 'flex' : 'none';
      if (m === 'duel') { duelPair = null; renderDuel(); }
    }

    // ---- Karta TOP 3 (Instagram Stories / TikTok) ----
    function openShare() {
      const chads = duelPool().sort(function(a, b) { return a.rank - b.rank; });
      if (chads.length < 3) return alert(L2('Za mało odblokowanych osób.', 'Not enough unlocked people.'));
      const box = document.getElementById('sharePickers');
      box.innerHTML = [0, 1, 2].map(function(i) {
        return '<select class="auth-input" id="sharePick' + i + '" style="margin-bottom:0;">' +
          chads.map(function(c, idx) {
            return '<option value="' + esc(c.id) + '"' + (idx === i ? ' selected' : '') + '>#' + (i + 1) + ' → ' + esc(c.name) + '</option>';
          }).join('') + '</select>';
      }).join('');
      document.getElementById('shareTitle').innerText = '📸 ' + L2('Twoje TOP 3', 'Your TOP 3');
      document.getElementById('shareSub').innerText = L2('Wybierz swoich faworytów i wygeneruj kartę na Instagram / TikTok.', 'Pick your favourites and generate a card for Instagram / TikTok.');
      document.getElementById('btnGenCard').innerText = L2('Generuj kartę', 'Generate card');
      document.getElementById('btnShareNative').innerText = '📤 ' + L2('Udostępnij', 'Share');
      document.getElementById('btnDownload').innerText = '⬇️ ' + L2('Pobierz PNG', 'Download PNG');
      document.getElementById('shareImg').style.display = 'none';
      document.getElementById('shareActions').style.display = 'none';
      document.getElementById('shareModal').style.display = 'flex';
    }
    function closeShare() {
      document.getElementById('shareModal').style.display = 'none';
      if (shareUrl) { URL.revokeObjectURL(shareUrl); shareUrl = null; }
      shareBlob = null;
    }
    function loadImg(src) {
      return new Promise(function(res) {
        const im = new Image();
        let done = false;
        const fin = function(v) { if (!done) { done = true; res(v); } };
        im.crossOrigin = 'anonymous';
        im.onload = function() { fin(im); };
        im.onerror = function() { fin(null); };
        setTimeout(function() { fin(null); }, 6000);
        im.src = src;
      });
    }
    function fitText(ctx, text, maxW, size, weight) {
      let sz = size;
      do { ctx.font = weight + ' ' + sz + 'px system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif'; sz -= 2; }
      while (ctx.measureText(text).width > maxW && sz > 18);
    }
    function roundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y); ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y); ctx.closePath();
    }
    function drawCard(chads, photos, withPhotos) {
      const W = 1080, H = 1920;
      const cv = document.createElement('canvas'); cv.width = W; cv.height = H;
      const ctx = cv.getContext('2d');
      const bg = ctx.createLinearGradient(0, 0, 0, H);
      bg.addColorStop(0, '#2a0f4d'); bg.addColorStop(1, '#08070c');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
      const glow = ctx.createRadialGradient(W / 2, 380, 40, W / 2, 380, 700);
      glow.addColorStop(0, 'rgba(168,85,247,0.45)'); glow.addColorStop(1, 'rgba(168,85,247,0)');
      ctx.fillStyle = glow; ctx.fillRect(0, 0, W, 900);
      ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = '#c084fc'; fitText(ctx, 'POLISH CHAD RANKINGS', 900, 64, '800'); ctx.fillText('POLISH CHAD RANKINGS', W / 2, 210);
      ctx.fillStyle = '#facc15'; fitText(ctx, L2('MOJE TOP 3', 'MY TOP 3'), 900, 150, '900'); ctx.fillText(L2('MOJE TOP 3', 'MY TOP 3'), W / 2, 400);
      const colors = ['#facc15', '#d1d5db', '#d97706'];
      for (let i = 0; i < 3; i++) {
        const c = chads[i], y = 500 + i * 380, x = 70, w = W - 140, h = 340;
        ctx.fillStyle = 'rgba(255,255,255,0.07)'; roundRect(ctx, x, y, w, h, 40); ctx.fill();
        ctx.strokeStyle = colors[i]; ctx.lineWidth = 4; roundRect(ctx, x, y, w, h, 40); ctx.stroke();
        ctx.textAlign = 'left'; ctx.fillStyle = colors[i]; ctx.font = '900 150px system-ui, Arial, sans-serif';
        ctx.fillText('#' + (i + 1), x + 40, y + 215);
        const cx = x + 520, cy = y + h / 2, r = 120;
        ctx.save(); ctx.beginPath(); ctx.arc(cx - 150, cy, r, 0, Math.PI * 2); ctx.closePath(); ctx.clip();
        if (withPhotos && photos[i]) {
          const im = photos[i], s = Math.max(2 * r / im.width, 2 * r / im.height);
          ctx.drawImage(im, cx - 150 - im.width * s / 2, cy - im.height * s / 2, im.width * s, im.height * s);
        } else { ctx.fillStyle = '#3b1d66'; ctx.fillRect(cx - 150 - r, cy - r, 2 * r, 2 * r); }
        ctx.restore();
        ctx.strokeStyle = colors[i]; ctx.lineWidth = 6; ctx.beginPath(); ctx.arc(cx - 150, cy, r, 0, Math.PI * 2); ctx.stroke();
        const tx = cx - 10, maxW = x + w - tx - 30;
        ctx.fillStyle = '#ffffff'; fitText(ctx, c.name, maxW, 62, '800'); ctx.fillText(c.name, tx, cy - 10);
        const sub = currentLang === 'pl' ? c.titlePl : c.titleEn;
        ctx.fillStyle = '#9ca3af'; fitText(ctx, sub || '', maxW, 36, '600'); ctx.fillText(sub || '', tx, cy + 45);
        ctx.fillStyle = '#c084fc'; fitText(ctx, 'AURA ' + getAura(c).toFixed(1), maxW, 40, '800'); ctx.fillText('AURA ' + getAura(c).toFixed(1), tx, cy + 100);
      }
      const link = (location.host + location.pathname).replace(/index\.html$/, '').replace(/\/$/, '');
      ctx.textAlign = 'center'; ctx.fillStyle = '#ffffff'; fitText(ctx, link, 940, 48, '700'); ctx.fillText(link, W / 2, 1790);
      ctx.fillStyle = '#c084fc'; ctx.font = '600 38px system-ui, Arial, sans-serif';
      ctx.fillText(L2('Zagłosuj i ułóż własne TOP 3!', 'Vote and build your own TOP 3!'), W / 2, 1855);
      return cv;
    }
    async function generateCard() {
      const ids = [0, 1, 2].map(function(i) { return document.getElementById('sharePick' + i).value; });
      if (new Set(ids).size < 3) return alert(L2('Wybierz 3 różne osoby.', 'Pick 3 different people.'));
      const chads = ids.map(function(id) { return chadsData.find(function(c) { return c.id === id; }); });
      const btn = document.getElementById('btnGenCard');
      btn.disabled = true; btn.innerText = L2('Generowanie…', 'Generating…');
      try {
        const photos = await Promise.all(chads.map(function(c) { return c.img ? loadImg(c.img) : Promise.resolve(null); }));
        const toBlob = function(cv) { return new Promise(function(res, rej) {
          try { cv.toBlob(function(b) { b ? res(b) : rej(new Error('blob')); }, 'image/png'); } catch (e) { rej(e); }
        }); };
        let blob;
        try { blob = await toBlob(drawCard(chads, photos, true)); }
        catch (e) { blob = await toBlob(drawCard(chads, photos, false)); }
        if (shareUrl) URL.revokeObjectURL(shareUrl);
        shareBlob = blob; shareUrl = URL.createObjectURL(blob);
        const img = document.getElementById('shareImg');
        img.src = shareUrl; img.style.display = 'block';
        document.getElementById('shareActions').style.display = 'flex';
      } catch (e) {
        alert(L2('Nie udało się wygenerować karty.', 'Could not generate the card.'));
      } finally {
        btn.disabled = false; btn.innerText = L2('Generuj kartę', 'Generate card');
      }
    }
    function downloadCard() {
      if (!shareUrl) return;
      const a = document.createElement('a');
      a.href = shareUrl; a.download = 'polish-chad-top3.png';
      document.body.appendChild(a); a.click(); a.remove();
    }
    async function shareCard() {
      if (!shareBlob) return;
      const file = new File([shareBlob], 'polish-chad-top3.png', { type: 'image/png' });
      const url = location.origin + location.pathname.replace(/index\.html$/, '');
      try {
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: 'Polish Chad Rankings', text: L2('Moje TOP 3! ', 'My TOP 3! ') + url });
        } else { downloadCard(); }
      } catch (e) { if (!e || e.name !== 'AbortError') downloadCard(); }
    }

    // ---- Podpięcie Firebase i render ----
    listen('aura', function(s) { auraCache = s.val() || {}; renderRankings(); refreshModalAura(); renderFarmers(); renderArchive(); });
    listen('prevRankings', function(s) { prevRankCache = s.val() || {}; renderRankings(); });
    listen('history', function(s) { historyCache = s.val() || {}; renderFarmers(); renderArchive(); });
    listen('weekId', function(s) { weekIdCache = s.val(); renderStreak(); refreshPower(); updateAuthUI(); });
    listen('duelStats', function(s) { duelStatsCache = s.val() || {}; refreshModalDuel(); });

    function bindUserExtras() {
      const u = auth.currentUser;
      const uid = (u && !u.isAnonymous) ? u.uid : null;
      if (uid === extrasUid) return;
      extrasRefs.forEach(function(r) { r.off(); });
      extrasRefs = [];
      extrasUid = uid; myWeeksCache = {}; mySuper = null; myMega = null;
      if (uid) {
        const a = db.ref('userWeeks/' + uid), b = db.ref('superLog/' + uid), c = db.ref('megaLog/' + uid);
        a.on('value', function(s) { myWeeksCache = s.val() || {}; renderStreak(); updateAuthUI(); }, noop);
        b.on('value', function(s) { mySuper = s.val(); refreshPower(); }, noop);
        c.on('value', function(s) { myMega = s.val(); refreshPower(); }, noop);
        extrasRefs = [a, b, c];
      }
      renderStreak(); refreshPower(); updateAuthUI();
    }
    auth.onAuthStateChanged(bindUserExtras);

    function renderExtras() {
      const tab = document.getElementById('txt-tab-archive');
      if (tab) tab.innerText = '🏆 ' + L2('Archiwum', 'Archive');
      document.getElementById('modeList').innerText = '📋 ' + L2('Lista', 'List');
      document.getElementById('modeDuel').innerText = '⚔️ Matchup';
      document.getElementById('btnShareOpen').innerText = '📸 TOP 3';
      renderFarmers(); renderStreak(); renderArchive(); renderDuel(); refreshPower(); refreshModalDuel(); refreshModalAura();
    }

    setupPollUI();
    renderRankings();
    renderHallOfFame();
    updateAuthUI();
    updateCountdown();
    renderExtras();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
